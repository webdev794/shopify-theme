[
  {
    "name": "theme_info",
    "theme_name": "Suvara",
    "theme_version": "0.1.0",
    "theme_author": "Caresort Technologies",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },

      {
        "type": "header",
        "content": "Secondary colors"
      },
      {
        "type": "color",
        "id": "background_color_secondary",
        "default": "#F5F5F5",
        "label": "Secondary background"
      },
      {
        "type": "color",
        "id": "foreground_color_secondary",
        "default": "#1A1A1A",
        "label": "Secondary foreground"
      },

      {
        "type": "header",
        "content": "Accent / Buttons"
      },
      {
        "type": "color",
        "id": "accent_background",
        "default": "#121212",
        "label": "Accent background"
      },
      {
        "type": "color",
        "id": "accent_foreground",
        "default": "#FFFFFF",
        "label": "Accent foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      },

      {
        "type": "header",
        "content": "Status Colors"
      },
      {
        "type": "color",
        "id": "color_sale",
        "default": "#c62828",
        "label": "Sale / Discount color"
      },
      {
        "type": "color",
        "id": "color_sold_out",
        "default": "#767676",
        "label": "Sold out color"
      },
      {
        "type": "color",
        "id": "color_success",
        "default": "#2e7d32",
        "label": "Success color"
      },
      {
        "type": "color",
        "id": "color_success_bg",
        "default": "#e6f4ea",
        "label": "Success background"
      },
      {
        "type": "color",
        "id": "color_success_text",
        "default": "#1e4620",
        "label": "Success text color"
      },
      {
        "type": "color",
        "id": "color_error",
        "default": "#c62828",
        "label": "Error color"
      },
      {
        "type": "color",
        "id": "color_error_bg",
        "default": "#fee2e2",
        "label": "Error background"
      },
      {
        "type": "color",
        "id": "color_error_text",
        "default": "#991b1b",
        "label": "Error text color"
      },
      {
        "type": "color",
        "id": "color_star",
        "default": "#b8860b",
        "label": "Star rating color"
      },
      {
        "type": "color",
        "id": "color_disabled",
        "default": "#888",
        "label": "Disabled color"
      },
      {
        "type": "color",
        "id": "color_disabled_dark",
        "default": "#aaa",
        "label": "Disabled dark color"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Leave any URL blank to hide that icon. Icons only appear for platforms with a URL entered."
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter/X URL"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_linkedin_link",
        "label": "LinkedIn URL"
      }
    ]
  }
]