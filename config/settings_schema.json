[
  {
    "name": "theme_info",
    "theme_name": "Suvara",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Wavy Marquee",
    "settings": [
      {
        "type": "group",
        "name": "Global Marquee Settings",
        "settings": [
          {
            "type": "text",
            "id": "wavy_marquee_default_text",
            "label": "Default Marquee Text",
            "default": "Welcome to our store!"
          },
          {
            "type": "color",
            "id": "wavy_marquee_default_color",
            "label": "Default Text Color",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "wavy_marquee_default_bg",
            "label": "Default Background Color",
            "default": "#1a1a1a"
          }
        ]
      }
    ]
  },
  {
    "name": "Slideshow with Marquee",
    "settings": [
      {
        "type": "text",
        "id": "marquee_default_text",
        "label": "Default Scrolling Text",
        "default": "Free Shipping • 30-Day Returns • Subscribe & Save"
      },
      {
        "type": "color",
        "id": "marquee_default_text_color",
        "label": "Text Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "marquee_default_bg",
        "label": "Background Color",
        "default": "#1a1a1a"
      }
    ]
  }
]
