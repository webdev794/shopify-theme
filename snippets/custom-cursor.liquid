/* ========== CUSTOM CURSOR STYLES ========== */
/* Single cursor (rose-cursor.svg) used site-wide */

/* Default cursor - everywhere on the site */
body {
  cursor: url('{{ "rose-cursor.svg" | asset_url }}') 16 16, auto;
}

/* Keep same cursor on hover for interactive elements (no separate hover graphic) */
a:hover,
button:hover,
input[type="submit"]:hover,
.product-card:hover,
.collection-card:hover,
.product-form__submit:hover,
.add-to-cart:hover,
.shopify-payment-button__button:hover {
  cursor: url('{{ "rose-cursor.svg" | asset_url }}') 16 16, pointer !important;
}

/* Hide custom cursor on touch devices */
@media (hover: none) and (pointer: coarse) {
  body,
  a:hover,
  button:hover {
    cursor: auto !important;
  }
}

/* Fallback for browsers that don't support SVG cursors */
@supports not (cursor: url()) {
  body {
    cursor: auto;
  }
}

/* Reduced motion preference - use simpler cursor */
@media (prefers-reduced-motion: reduce) {
  body {
    cursor: auto;
  }
}