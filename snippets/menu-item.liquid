{% comment %}
  Recursive menu item for nested menus
  Usage: {% render 'menu-item', link: link, level: 1 %}
{% endcomment %}

{% assign level = level | default: 1 %}
{% assign class_prefix = 'level-' | append: level %}

<li class="nav-item {{ class_prefix }}">
  <div class="nav-item-header small-font">
    <a href="{{ link.url }}" title="{{ link.title }}" tabindex="-1">{{ link.title }}</a>
    {% if link.links.size > 0 %}
      <span data-submenu-trigger="child{{ level }}{{ forloop.index }}">
        {% render 'icon-chevron-down' %}
      </span>
    {% endif %}
  </div>
  
  {% if link.links.size > 0 %}
    <div class="inner-child child body-font regular-font" data-inner-item="child{{ level }}{{ forloop.index }}">
      <ul class="list-unstyled">
        {% for child_link in link.links %}
          {% render 'menu-item', link: child_link, level: level | plus: 1 %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</li>