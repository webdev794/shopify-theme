{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'newsletter.js' | asset_url }}" defer></script>

<div 
  class="newsletter" 
  data-section-id="{{ section.id }}"
  data-style="{{ section.settings.style }}"
  data-bg-color="{{ section.settings.background_color }}"
  data-text-color="{{ section.settings.section_text_color }}"
  data-background-image="{{ section.settings.background_image | image_url }}"
>
  <div class="newsletter__container">
    <div class="newsletter__content">
      {% if section.settings.subheading != blank %}
        <span class="newsletter__subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="newsletter__description">{{ section.settings.description }}</div>
      {% endif %}
      
      {% form 'customer' %}
        {{ form.errors | default_errors }}
        
        {% if form.posted_successfully? %}
          <div class="newsletter__success">
            <svg class="newsletter__success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <p>{{ section.settings.success_message }}</p>
          </div>
        {% else %}
          <div class="newsletter__form">
            <input 
              type="hidden" 
              name="contact[tags]" 
              value="newsletter"
            >
            <div class="newsletter__field-group">
              <input
                type="email"
                name="contact[email]"
                id="NewsletterForm-{{ section.id }}"
                class="newsletter__input"
                placeholder="{{ section.settings.placeholder }}"
                required
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success-{{ section.id }}"
                {% endif %}
              >
              <button 
                type="submit" 
                class="newsletter__button newsletter__button--{{ section.settings.button_style }}"
                name="commit"
                id="Subscribe-{{ section.id }}"
              >
                <span class="newsletter__button-text">
                  {{ section.settings.button_label }}
                </span>
                
                {% if section.settings.show_icon %}
                  <svg class="newsletter__button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                {% endif %}
              </button>
            </div>
            
            {% if section.settings.show_note %}
              <p class="newsletter__note">{{ section.settings.note_text }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endform %}
      
      {% if section.settings.show_social %}
        <div class="newsletter__social">
          <span class="newsletter__social-label">{{ section.settings.social_label }}</span>
          <div class="newsletter__social-icons">
            {% if settings.social_facebook_link != blank %}
              <a href="{{ settings.social_facebook_link }}" class="newsletter__social-link" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            {% endif %}
            
            {% if settings.social_twitter_link != blank %}
              <a href="{{ settings.social_twitter_link }}" class="newsletter__social-link" target="_blank" rel="noopener" aria-label="Twitter">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {% endif %}
            
            {% if settings.social_instagram_link != blank %}
              <a href="{{ settings.social_instagram_link }}" class="newsletter__social-link" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/></svg>
              </a>
            {% endif %}
            
            {% if settings.social_youtube_link != blank %}
              <a href="{{ settings.social_youtube_link }}" class="newsletter__social-link" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "t:sections.newsletter.settings.header__1.content" },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.newsletter.settings.subheading.label",
      "default": "Subscribe Now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Join Our Newsletter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.newsletter.settings.description.label",
      "default": "<p>Subscribe to get special offers, free giveaways, and exclusive deals.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:sections.newsletter.settings.placeholder.label",
      "default": "Enter your email"
    },
    { "type": "header", "content": "t:sections.newsletter.settings.header__2.content" },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.newsletter.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:sections.newsletter.settings.button_style.options__1.label" },
        { "value": "gradient", "label": "t:sections.newsletter.settings.button_style.options__2.label" },
        { "value": "outline", "label": "t:sections.newsletter.settings.button_style.options__3.label" },
        { "value": "pill", "label": "t:sections.newsletter.settings.button_style.options__4.label" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:sections.newsletter.settings.show_icon.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.newsletter.settings.header__3.content" },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.newsletter.settings.style.label",
      "options": [
        { "value": "default", "label": "t:sections.newsletter.settings.style.options__1.label" },
        { "value": "minimal", "label": "t:sections.newsletter.settings.style.options__2.label" },
        { "value": "bordered", "label": "t:sections.newsletter.settings.style.options__3.label" },
        { "value": "shadow", "label": "t:sections.newsletter.settings.style.options__4.label" },
        { "value": "background", "label": "t:sections.newsletter.settings.style.options__5.label" }
      ],
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.newsletter.settings.background_image.label",
      "info": "t:sections.newsletter.settings.background_image.info"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.newsletter.settings.background_color.label",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "t:sections.newsletter.settings.section_text_color.label",
      "default": "#1a1a2e"
    },
    { "type": "header", "content": "t:sections.newsletter.settings.header__4.content" },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:sections.newsletter.settings.show_note.label",
      "default": true
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "t:sections.newsletter.settings.note_text.label",
      "default": "No spam. Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:sections.newsletter.settings.success_message.label",
      "default": "Thanks for subscribing!"
    },
    { "type": "header", "content": "t:sections.newsletter.settings.header__5.content" },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.newsletter.settings.show_social.label",
      "default": true
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "t:sections.newsletter.settings.social_label.label",
      "default": "Follow us:"
    }
  ],
  "presets": [
    { "name": "t:sections.newsletter.presets.name" }
  ]
}
{% endschema %}
