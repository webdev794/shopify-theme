{%- comment -%}
  Footer — upgraded design
  • Brand column with optional tagline
  • Up to 4 menu columns (merchant-configurable blocks)
  • Newsletter signup (Shopify customer form)
  • Social icons, payment icons, localized copyright bar
{%- endcomment -%}

<footer class="footer color-scheme-{{ section.settings.color_scheme | default: 'default' }}">
  <div class="footer__inner page-width">

    {%- comment -%} ── Top: brand / menus / newsletter ── {%- endcomment -%}
    <div class="footer__top">

      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- if section.settings.logo -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, widths: '150, 300', class: 'footer__logo-img' }}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <ul class="footer__social" role="list">
            {%- if section.settings.social_instagram != blank -%}
              <li>
                <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_facebook != blank -%}
              <li>
                <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.3v3h2.4v7h2.8z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <li>
                <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.3 1.9 1.6 3.4 3.5 3.7v3c-1.3 0-2.5-.4-3.5-1.1v5.9c0 3.4-2.6 5.5-5.4 5.5A5.3 5.3 0 0 1 5.8 14a5.4 5.4 0 0 1 5.9-5.3v3.1a2.4 2.4 0 0 0-3 2.3c0 1.3 1.1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.6V3h3z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <li>
                <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8s-.1-3.2-.4-4.8zM10 15.2V8.8l5.3 3.2L10 15.2z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.social_x != blank -%}
              <li>
                <a href="{{ section.settings.social_x }}" target="_blank" rel="noopener" aria-label="X (Twitter)">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.6 3H21l-7.4 8.5L22.2 21h-6.8l-5.3-6.3L4 21H.6L8.5 12 .2 3h7l4.8 5.7L17.6 3zm-1.2 16h1.9L6.6 4.9H4.6L16.4 19z"/></svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__menus">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              <nav class="footer__menu" aria-label="{{ block.settings.heading | default: block.settings.menu.title }}" {{ block.shopify_attributes }}>
                {%- assign col_heading = block.settings.heading | default: block.settings.menu.title -%}
                {%- if col_heading != blank -%}
                  <h2 class="footer__heading">{{ col_heading }}</h2>
                {%- endif -%}
                <ul class="footer__menu-list" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>

            {%- when 'text' -%}
              <div class="footer__menu footer__text-block" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="footer__richtext">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          <h2 class="footer__heading">{{ section.settings.newsletter_heading | default: 'Stay in the loop' }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__field">
              <label for="Footer-NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_label' | t | default: 'Email' }}</label>
              <input
                id="Footer-NewsletterEmail"
                type="email"
                name="contact[email]"
                class="footer__input"
                value="{{ form.email }}"
                placeholder="{{ 'general.newsletter.email_placeholder' | t | default: 'Your email address' }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="footer__submit" aria-label="{{ 'general.newsletter.submit' | t | default: 'Subscribe' }}">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>

            {%- if form.errors -%}
              <p class="footer__form-message footer__form-message--error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer__form-message footer__form-message--success" role="status">
                {{ 'general.newsletter.success' | t | default: 'Thanks for subscribing!' }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Bottom bar: copyright / payments ── {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__copyright">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
        <span class="footer__powered">{{ powered_by_link }}</span>
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'general.payment_methods' | t | default: 'Payment methods' }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    --footer-bg: var(--color-background, #ffffff);
    --footer-fg: var(--color-foreground, #121212);
    --footer-muted: color-mix(in srgb, var(--footer-fg) 62%, var(--footer-bg));
    --footer-line: color-mix(in srgb, var(--footer-fg) 12%, var(--footer-bg));
    background: var(--footer-bg);
    color: var(--footer-fg);
    border-top: 1px solid var(--footer-line);
    margin-top: 4rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 1.5rem;
  }

  /* ── Top grid ── */
  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 2fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer__brand { max-width: 32ch; }

  .footer__logo { display: inline-block; color: inherit; text-decoration: none; }
  .footer__logo-img { max-width: 150px; height: auto; display: block; }
  .footer__logo-text {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .footer__tagline {
    margin: 0.9rem 0 0;
    color: var(--footer-muted);
  }

  /* ── Social ── */
  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--footer-line);
    border-radius: 50%;
    color: var(--footer-fg);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .footer__social a:hover {
    background: var(--footer-fg);
    color: var(--footer-bg);
    border-color: var(--footer-fg);
  }

  /* ── Menus ── */
  .footer__menus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
  }

  .footer__heading {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin: 0 0 1rem;
    color: var(--footer-fg);
  }

  .footer__menu-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .footer__link,
  .footer__richtext a {
    color: var(--footer-muted);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: color 0.2s ease, background-size 0.25s ease;
  }
  .footer__link:hover,
  .footer__richtext a:hover {
    color: var(--footer-fg);
    background-size: 100% 1px;
  }

  .footer__richtext { color: var(--footer-muted); }
  .footer__richtext p { margin: 0 0 0.6rem; }

  /* ── Newsletter ── */
  .footer__newsletter-text {
    margin: 0 0 1rem;
    color: var(--footer-muted);
  }

  .footer__field {
    display: flex;
    border: 1px solid var(--footer-line);
    border-radius: 999px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .footer__field:focus-within {
    border-color: var(--footer-fg);
  }

  .footer__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0.75rem 1.1rem;
    font: inherit;
  }
  .footer__input:focus { outline: none; }
  .footer__input::placeholder { color: var(--footer-muted); }

  .footer__submit {
    display: grid;
    place-items: center;
    width: 3rem;
    border: 0;
    background: var(--footer-fg);
    color: var(--footer-bg);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .footer__submit:hover { opacity: 0.85; }

  .footer__form-message { margin: 0.6rem 0 0; font-size: 0.85rem; }
  .footer__form-message--error { color: #c0392b; }
  .footer__form-message--success { color: #1e8e5a; }

  /* ── Bottom bar ── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--footer-line);
    padding-top: 1.5rem;
  }

  .footer__copyright {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--footer-muted);
  }
  .footer__copyright a {
    color: inherit;
    text-decoration: none;
  }
  .footer__copyright a:hover { color: var(--footer-fg); }

  .footer__payment {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__payment-icon {
    display: block;
    height: 24px;
    width: auto;
    border-radius: 3px;
  }

  /* ── Focus visibility ── */
  .footer a:focus-visible,
  .footer button:focus-visible,
  .footer input:focus-visible {
    outline: 2px solid var(--footer-fg);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ── Responsive ── */
  @media (max-width: 990px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
    .footer__newsletter { grid-column: 1 / -1; max-width: 30rem; }
  }

  @media (max-width: 640px) {
    .footer__inner { padding-top: 2.5rem; }
    .footer__top { grid-template-columns: 1fr; gap: 2.25rem; }
    .footer__menus { grid-template-columns: repeat(2, 1fr); }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer * { transition: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Quality products, thoughtfully made."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New arrivals, exclusive offers, and more — straight to your inbox."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter) URL"
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the menu's title."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, contact info, or brand values with your customers.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
