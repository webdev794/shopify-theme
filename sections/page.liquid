{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page" data-content-width="{{ section.settings.content_width }}">
  <div class="page__page-width">
    <h1 class="page__title">{{ page.title }}</h1>

    {% if page.metafields.custom.image %}
      <div class="page__image">
        {{
          page.metafields.custom.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            widths: '600,900,1200',
            alt: page.title,
            class: 'page__image-el'
        }}
      </div>
    {% endif %}

    <div class="page__content">
      {{ page.content }}
    </div>
  </div>
</div>

{% stylesheet %}
  .page {
    padding-block: 3rem 4rem;
  }

  .page__page-width {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .page[data-content-width='narrow'] .page__page-width {
    max-width: 38rem;
  }

  .page[data-content-width='wide'] .page__page-width {
    max-width: 64rem;
  }

  .page__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.4rem);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .page__image {
    margin-bottom: 2rem;
    border-radius: 0.6rem;
    overflow: hidden;
  }

  .page__image-el {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    display: block;
  }

  /* ---------- Rich text content ---------- */
  .page__content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-foreground, #1a1a1a);
  }

  .page__content > * + * {
    margin-top: 1.25rem;
  }

  .page__content h1,
  .page__content h2,
  .page__content h3,
  .page__content h4,
  .page__content h5,
  .page__content h6 {
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .page__content h1 {
    font-size: 1.8rem;
  }

  .page__content h2 {
    font-size: 1.5rem;
  }

  .page__content h3 {
    font-size: 1.25rem;
  }

  .page__content h4,
  .page__content h5,
  .page__content h6 {
    font-size: 1.05rem;
  }

  .page__content p {
    margin: 0;
  }

  .page__content a {
    color: var(--color-foreground, #1a1a1a);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page__content a:hover {
    text-decoration-thickness: 2px;
  }

  .page__content ul,
  .page__content ol {
    padding-left: 1.5rem;
  }

  .page__content li + li {
    margin-top: 0.4rem;
  }

  .page__content blockquote {
    border-left: 3px solid var(--color-border, #ddd);
    padding-left: 1.25rem;
    color: var(--color-foreground-secondary, #555);
    font-style: italic;
  }

  .page__content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    display: block;
  }

  .page__content hr {
    border: none;
    border-top: 1px solid var(--color-border, #e5e5e5);
    margin: 2rem 0;
  }

  .page__content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: var(--color-background-secondary, #f4f4f4);
    padding: 0.15rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }

  .page__content pre {
    background: var(--color-background-secondary, #f4f4f4);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .page__content pre code {
    background: none;
    padding: 0;
  }

  .page__content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .page__content th,
  .page__content td {
    border: 1px solid var(--color-border, #e5e5e5);
    padding: 0.6rem 0.75rem;
    text-align: left;
  }

  .page__content th {
    background: var(--color-background-secondary, #f4f4f4);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .page__content table {
      display: block;
      overflow-x: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.page.settings.content_width.label",
      "options": [
        { "value": "narrow", "label": "t:sections.page.settings.content_width.options__1.label" },
        { "value": "medium", "label": "t:sections.page.settings.content_width.options__2.label" },
        { "value": "wide", "label": "t:sections.page.settings.content_width.options__3.label" }
      ],
      "default": "medium"
    }
  ]
}
{% endschema %}
