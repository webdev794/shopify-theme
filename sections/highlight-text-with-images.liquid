{%- comment -%}
  Highlight Text with Images
  - One large statement sentence composed from alternating blocks:
    text phrases and small inline images woven between the words
  - Text phrases can be styled: regular, accent color, italic, highlighted
  - Images are sized in em so they scale perfectly with the text, with a
    per-image tilt for an editorial, hand-placed feel
  - Optional staggered reveal on scroll (tiny JS, only loaded when enabled,
    disabled under prefers-reduced-motion)
  - Empty image blocks render placeholders so the section always looks
    composed in the editor and demo store
{%- endcomment -%}

{%- liquid
  if section.index == 1
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}

{{ 'highlight-text-with-images.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_animation -%}
  <script src="{{ 'highlight-text-with-images.js' | asset_url }}" defer></script>
{%- endif -%}

<div
  class="hlt hlt--{{ section.settings.text_size }} hlt--align-{{ section.settings.alignment }} hlt--shape-{{ section.settings.image_shape }}{% if section.settings.enable_animation %} hlt--animated{% endif %}"
  style="
    --hlt-background: {{ section.settings.color_background }};
    --hlt-foreground: {{ section.settings.color_foreground }};
    --hlt-accent: {{ section.settings.color_accent }};
    --hlt-image-scale: {{ section.settings.image_size | divided_by: 100.0 }};
  "
  {% if section.settings.enable_animation %}data-hlt{% endif %}
>
  <div class="hlt__inner">
    {%- if section.settings.caption != blank -%}
      <p class="hlt__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <h2 class="hlt__statement">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <span
                  class="hlt__word{% if block.settings.style != 'regular' %} hlt__word--{{ block.settings.style }}{% endif %}"
                  style="--i: {{ forloop.index0 }};"
                  {{ block.shopify_attributes }}
                >{{ block.settings.text | escape }}</span>
                {{- ' ' -}}
              {%- endif -%}

            {%- when 'image' -%}
              <span
                class="hlt__media"
                style="--i: {{ forloop.index0 }}; --hlt-tilt: {{ block.settings.tilt }}deg;"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign focal_style = nil
                    if block.settings.image.presentation.focal_point
                      assign focal_style = 'object-position: ' | append: block.settings.image.presentation.focal_point
                    endif
                  -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      class: 'hlt__image',
                      widths: '200, 400',
                      sizes: '160px',
                      loading: loading,
                      alt: block.settings.image.alt,
                      style: focal_style
                  }}
                {%- else -%}
                  {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                  {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'hlt__image hlt__image--placeholder' }}
                {%- endif -%}
              </span>
              {{- ' ' -}}
          {%- endcase -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="hlt__actions">
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="hlt__button button {% if section.settings.button_style == 'secondary' %}button--secondary hlt__button--secondary{% else %}button--primary hlt__button--primary{% endif %}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Highlight text + images",
  "tag": "section",
  "class": "section-hlt",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Our story"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "huge", "label": "Huge" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 80,
      "max": 160,
      "step": 10,
      "unit": "%",
      "default": 110,
      "info": "Relative to the text height, so images scale with the text on every screen"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "rounded", "label": "Rounded" },
        { "value": "pill", "label": "Pill" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "pill"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Effects"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Words and images fade in one after another as the section scrolls into view. Turned off for visitors who prefer reduced motion."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f5f4f2"
    },
    {
      "type": "color",
      "id": "color_foreground",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#b4552d",
      "info": "Used for accented and highlighted phrases"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "your words"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "regular", "label": "Regular" },
            { "value": "accent", "label": "Accent color" },
            { "value": "italic", "label": "Italic" },
            { "value": "highlighted", "label": "Highlighted" }
          ],
          "default": "regular"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "400 x 300px recommended. Set a focal point to control cropping."
        },
        {
          "type": "range",
          "id": "tilt",
          "label": "Tilt",
          "min": -8,
          "max": 8,
          "step": 1,
          "unit": "deg",
          "default": 0,
          "info": "A slight tilt gives a hand-placed, editorial feel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlight text + images",
      "blocks": [
        {
          "type": "text",
          "settings": { "text": "Crafted with care," }
        },
        {
          "type": "image",
          "settings": { "tilt": -4 }
        },
        {
          "type": "text",
          "settings": { "text": "made for", "style": "italic" }
        },
        {
          "type": "image",
          "settings": { "tilt": 3 }
        },
        {
          "type": "text",
          "settings": { "text": "every day.", "style": "accent" }
        }
      ]
    }
  ]
}
{% endschema %}
