{% comment %}
  Sticky Media Cards Section
  Version: 1.0
  Description: A section with sticky media cards that reveal content as you scroll
{% endcomment %}

{{ 'sticky-media-cards.css' | asset_url | stylesheet_tag }}

<div class="sticky-media-cards" data-section-id="{{ section.id }}" data-section-type="sticky-media-cards">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sticky-media-cards__header">
        <h2 class="sticky-media-cards__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="sticky-media-cards__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="sticky-media-cards__container">
    {%- for block in section.blocks -%}
      <div class="sticky-media-cards__section" {{ block.shopify_attributes }}>
        <div class="sticky-media-cards__wrapper page-width">
          <div class="sticky-media-cards__media{% if block.settings.media_position == 'right' %} sticky-media-cards__media--right{% endif %}">
            {%- if block.settings.media_type == 'image' -%}
              {%- if block.settings.image != blank -%}
                <div class="sticky-media-cards__image-wrapper">
                  <img
                    src="{{ block.settings.image | img_url: '800x', crop: 'center' }}"
                    srcset="{{ block.settings.image | img_url: '800x', crop: 'center' }} 1x, {{ block.settings.image | img_url: '1600x', crop: 'center' }} 2x"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="600"
                    class="sticky-media-cards__image"
                  >
                </div>
              {%- else -%}
                <div class="sticky-media-cards__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'sticky-media-cards__placeholder-svg' }}
                </div>
              {%- endif -%}
            {%- else -%}
              {%- if block.settings.video_url != blank -%}
                <div class="sticky-media-cards__video-wrapper">
                  <video
                    class="sticky-media-cards__video"
                    src="{{ block.settings.video_url }}"
                    poster="{{ block.settings.image | img_url: '800x' }}"
                    muted
                    loop
                    playsinline
                    autoplay
                  ></video>
                  <button class="sticky-media-cards__video-control" aria-label="Play/Pause video" type="button">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
              {%- else -%}
                <div class="sticky-media-cards__placeholder">
                  {{ 'video' | placeholder_svg_tag: 'sticky-media-cards__placeholder-svg' }}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="sticky-media-cards__content">
            <div class="sticky-media-cards__card">
              <div class="sticky-media-cards__card-inner">
                {%- if block.settings.icon != 'none' -%}
                  <div class="sticky-media-cards__icon-wrapper">
                    {%- render 'icon', icon: block.settings.icon -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="sticky-media-cards__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="sticky-media-cards__text rte">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="sticky-media-cards__button btn">
                    {{ block.settings.button_text | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="sticky-media-cards__empty page-width">
        <p>Add media cards to display them here.</p>
        {%- if shop.editor_mode -%}
          <p><small>Click "Add block" to add content</small></p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'sticky-media-cards.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sticky Media Cards",
  "tag": "section",
  "class": "sticky-media-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A step-by-step guide to get started"
    }
  ],
  "blocks": [
    {
      "type": "media_card",
      "name": "Media Card",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "URL to an MP4 video file"
        },
        {
          "type": "select",
          "id": "media_position",
          "label": "Media position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step in the process.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky Media Cards",
      "blocks": [
        {
          "type": "media_card",
          "settings": {
            "title": "Discover Our Products",
            "text": "<p>Browse our curated collection of premium products.</p>",
            "icon": "star"
          }
        },
        {
          "type": "media_card",
          "settings": {
            "title": "Add to Cart",
            "text": "<p>Select your items and add them to your shopping cart.</p>",
            "icon": "check"
          }
        },
        {
          "type": "media_card",
          "settings": {
            "title": "Fast Delivery",
            "text": "<p>Get your order delivered quickly to your doorstep.</p>",
            "icon": "truck"
          }
        }
      ]
    }
  ]
}
{% endschema %}