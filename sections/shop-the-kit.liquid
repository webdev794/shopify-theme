{% comment %}
  Shop the Kit Section
  Version: 2.0 — Editorial redesign
  Description: A curated product bundle/kit display with add-to-cart functionality
{% endcomment %}

{{ 'shop-the-kit.css' | asset_url | stylesheet_tag }}

{%- assign stk_bleed = false -%}
{%- if section.settings.section_width == 'full_bleed' -%}
  {%- assign stk_bleed = true -%}
{%- endif -%}

{%- comment -%} Auto-calc kit savings from compare-at prices when present, otherwise fall back to merchant text. {%- endcomment -%}
{%- assign stk_price_total = 0 -%}
{%- assign stk_compare_total = 0 -%}
{%- for block in section.blocks -%}
  {%- assign stk_p = block.settings.product -%}
  {%- if stk_p != blank -%}
    {%- assign stk_price_total = stk_price_total | plus: stk_p.price -%}
    {%- if stk_p.compare_at_price > stk_p.price -%}
      {%- assign stk_compare_total = stk_compare_total | plus: stk_p.compare_at_price -%}
    {%- else -%}
      {%- assign stk_compare_total = stk_compare_total | plus: stk_p.price -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign stk_savings_label = section.settings.savings_text -%}
{%- if section.settings.auto_calc_savings and stk_compare_total > stk_price_total -%}
  {%- assign stk_diff = stk_compare_total | minus: stk_price_total -%}
  {%- assign stk_pct = stk_diff | times: 100.0 | divided_by: stk_compare_total -%}
  {%- assign stk_pct = stk_pct | round -%}
  {%- if stk_pct > 0 -%}
    {%- capture stk_savings_label -%}Save {{ stk_pct }}%{%- endcapture -%}
  {%- endif -%}
{%- endif -%}

<div
  class="shop-the-kit{% if section.settings.section_width == 'wide' %} shop-the-kit--wide{% endif %}{% if stk_bleed %} shop-the-kit--bleed{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="shop-the-kit"
  data-complete-the-look
  role="region"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="shop-the-kit__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="shop-the-kit__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="shop-the-kit__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="shop-the-kit__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    In "full bleed" mode the wrapper is NOT nested inside .page-width so the
    media column can extend to the true viewport edge. In "standard" / "wide"
    mode the wrapper stays inside .page-width like the original section.
  {%- endcomment -%}
  {%- capture stk_wrapper -%}
    <div class="shop-the-kit__wrapper">
      {%- if section.settings.image != blank -%}
        <div class="shop-the-kit__media">
          <div class="shop-the-kit__image-wrapper" data-stk-morph>
            <img
              src="{{ section.settings.image | image_url: width: 1000, height: 1250, crop: 'center' }}"
              srcset="{{ section.settings.image | image_url: width: 1000, height: 1250, crop: 'center' }} 1x, {{ section.settings.image | image_url: width: 2000, height: 2500, crop: 'center' }} 2x"
              alt="{{ section.settings.image.alt | default: section.settings.kit_title | escape }}"
              loading="lazy"
              width="1000"
              height="1250"
              class="shop-the-kit__image"
            >
          </div>
        </div>
      {%- else -%}
        <div class="shop-the-kit__media">
          <div class="shop-the-kit__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'shop-the-kit__placeholder-svg' }}
          </div>
        </div>
      {%- endif -%}

      <div class="shop-the-kit__content-pad">
        <div class="shop-the-kit__content">
          {%- if section.settings.kit_title != blank -%}
            <h3 class="shop-the-kit__kit-title">{{ section.settings.kit_title | escape }}</h3>
          {%- endif -%}

          {%- if stk_savings_label != blank -%}
            <span class="shop-the-kit__savings-badge">{{ stk_savings_label | escape }}</span>
          {%- endif -%}

          {%- if section.settings.kit_description != blank -%}
            <div class="shop-the-kit__kit-description rte">{{ section.settings.kit_description }}</div>
          {%- endif -%}

          <div class="shop-the-kit__products">
            {%- for block in section.blocks -%}
              {%- if block.settings.product != blank -%}
                {%- assign product = block.settings.product -%}
                <div class="shop-the-kit__product" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
                  {%- if product.featured_image != blank -%}
                    <div class="shop-the-kit__product-preview" aria-hidden="true">
                      <img
                        src="{{ product.featured_image | image_url: width: 800 }}"
                        srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 800 }} 800w, {{ product.featured_image | image_url: width: 1200 }} 1200w"
                        sizes="320px"
                        alt=""
                        loading="lazy"
                        width="800"
                        height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                        class="shop-the-kit__product-preview-image"
                      >
                      <p class="shop-the-kit__product-preview-title">{{ product.title | escape }}</p>
                    </div>
                  {%- endif -%}
                  <div class="shop-the-kit__product-card">
                    <span class="shop-the-kit__product-index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

                    <div class="shop-the-kit__product-image-wrapper">
                      {%- if product.featured_image != blank -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 240, height: 240, crop: 'center' }}"
                          srcset="{{ product.featured_image | image_url: width: 240, height: 240, crop: 'center' }} 1x, {{ product.featured_image | image_url: width: 480, height: 480, crop: 'center' }} 2x"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          loading="lazy"
                          width="240"
                          height="240"
                          class="shop-the-kit__product-image"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'shop-the-kit__product-image shop-the-kit__product-image--placeholder' }}
                      {%- endif -%}
                    </div>

                    <div class="shop-the-kit__product-info">
                      <p class="shop-the-kit__product-title">{{ product.title }}</p>

                      {%- if section.settings.show_variant_selector and product.has_only_default_variant == false -%}
                        <div class="shop-the-kit__product-options">
                          <select class="shop-the-kit__variant-selector" data-product-id="{{ product.id }}">
                            {%- for variant in product.variants -%}
                              <option value="{{ variant.id }}"
                                      {%- if forloop.first %} selected{% endif -%}
                                      data-price="{{ variant.price }}">
                                {{ variant.title }}
                              </option>
                            {%- endfor -%}
                          </select>
                        </div>
                      {%- else -%}
                        <div class="shop-the-kit__product-price">
                          <span class="shop-the-kit__product-price-current">{{ product.price | money }}</span>
                          {%- if product.compare_at_price > product.price -%}
                            <span class="shop-the-kit__product-price-compare">{{ product.compare_at_price | money }}</span>
                          {%- endif -%}
                        </div>
                        {%- comment -%}
                          Single-variant products (or when the variant selector is
                          disabled) don't render a <select>. The JS looks for
                          [data-variant-id] on these to know which variant to add
                          to cart, so we provide it here via a hidden element.
                        {%- endcomment -%}
                        <input
                          type="hidden"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- else -%}
                <div class="shop-the-kit__empty-product">
                  <p>{{ 'sections.shop_the_kit.select_product' | t }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="shop-the-kit__total">
            <div class="shop-the-kit__total-price">
              <span class="shop-the-kit__total-label">{{ section.settings.total_label | default: 'Total' | escape }}:</span>
              <span class="shop-the-kit__total-amount" id="kit-total-price-{{ section.id }}">
                {%- if section.blocks.size > 0 -%}
                  {%- assign total_price = 0 -%}
                  {%- for block in section.blocks -%}
                    {%- assign product = block.settings.product -%}
                    {%- if product != blank -%}
                      {%- assign total_price = total_price | plus: product.price -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {{ total_price | money }}
                {%- else -%}
                  {{ 0 | money }}
                {%- endif -%}
              </span>
            </div>

            <button class="shop-the-kit__add-to-cart btn btn--primary" type="button">
              {{ section.settings.add_to_cart_text | default: 'Add Kit to Cart' | escape }}
            </button>
          </div>

          {%- if section.settings.free_shipping_text != blank -%}
            <p class="shop-the-kit__free-shipping">
              <span class="shop-the-kit__free-shipping-icon">✓</span>
              {{ section.settings.free_shipping_text | escape }}
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endcapture -%}

  {%- if stk_bleed -%}
    {{ stk_wrapper }}
  {%- else -%}
    <div class="page-width">
      {{ stk_wrapper }}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'shop-the-kit.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.shop_the_kit.name",
  "tag": "section",
  "class": "shop-the-kit-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "look_id",
      "label": "Look ID (optional)",
      "info": "Match a Lookbook section Look ID to treat both as one Complete the Look system."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Small label above the heading, e.g. \"New Arrival\" or \"Curated Edit\".",
      "default": "Curated Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shop_the_kit.settings.heading.label",
      "default": "Shop the Kit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.shop_the_kit.settings.subheading.label",
      "default": "Everything you need in one complete bundle"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "wide", "label": "Wide" },
        { "value": "full_bleed", "label": "Full-bleed image" }
      ],
      "default": "full_bleed",
      "info": "Full-bleed extends the kit image to the edge of the browser on desktop for a more immersive, editorial feel."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shop_the_kit.settings.image.label",
      "info": "t:sections.shop_the_kit.settings.image.info"
    },
    {
      "type": "text",
      "id": "kit_title",
      "label": "t:sections.shop_the_kit.settings.kit_title.label",
      "default": "The Complete Starter Kit"
    },
    {
      "type": "checkbox",
      "id": "auto_calc_savings",
      "label": "Auto-calculate savings badge",
      "info": "Calculates the badge from each product's compare-at price. Falls back to the text below if there's nothing to calculate.",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Savings badge text",
      "default": "Save 20%"
    },
    {
      "type": "richtext",
      "id": "kit_description",
      "label": "t:sections.shop_the_kit.settings.kit_description.label",
      "default": "<p>This curated bundle includes everything you need to get started.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.shop_the_kit.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "t:sections.shop_the_kit.settings.show_variant_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shop_the_kit.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "t:sections.shop_the_kit.settings.add_to_cart_text.label",
      "default": "Complete the Look"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "t:sections.shop_the_kit.settings.total_label.label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "free_shipping_text",
      "label": "t:sections.shop_the_kit.settings.free_shipping_text.label",
      "default": "Free shipping on this kit"
    },
    {
      "type": "header",
      "content": "t:sections.shop_the_kit.settings.header__3.content"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.shop_the_kit.settings.aria_label.label",
      "default": "Shop the kit"
    },
    {
      "type": "checkbox",
      "id": "complete_look_mode",
      "label": "Use Complete the Look labeling",
      "default": true,
      "info": "Renames the primary CTA for consistency with Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.shop_the_kit.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shop_the_kit.blocks.product.settings.product.label",
          "info": "Only products you select here appear in the kit. Entire collections are never auto-loaded."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_the_kit.presets.name",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
