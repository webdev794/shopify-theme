{% comment %}
  Featured Products Section
  Version: 1.6 (Carousel arrows, cart event, image size, placeholders fixed)
{% endcomment %}

{{ 'featured-products.css' | asset_url | stylesheet_tag }}

<div class="featured-products"
     data-section-id="{{ section.id }}"
     data-section-type="featured-products"
     data-layout="{{ section.settings.layout }}"
     data-products-per-row="{{ section.settings.products_per_row }}"
     data-text-adding="{{ 'sections.featured_products.adding' | t }}"
     data-text-added="{{ 'sections.featured_products.added' | t }}"
     data-text-error="{{ 'sections.featured_products.error' | t }}"
     data-text-added-notice="{{ 'sections.featured_products.added_notice' | t }}"
     role="region"
     aria-label="{{ section.settings.aria_label | default: 'Featured products' | escape }}"
     style="
       --fp-bg: {{ section.settings.background_color }};
       --fp-text-color: {{ section.settings.text_color }};
       --fp-heading-color: {{ section.settings.heading_color }};
       --fp-card-bg: {{ section.settings.card_background }};
       --fp-card-shadow: {{ section.settings.card_shadow }};
       --fp-border-radius: {{ section.settings.border_radius }}px;
       --fp-gap: {{ section.settings.gap }}px;
       --fp-products-per-row: {{ section.settings.products_per_row }};
     ">

  <div class="featured-products__container{% if section.settings.full_width %} featured-products__container--full{% endif %}">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="featured-products__header">
        {%- if section.settings.subheading != blank -%}
          <p class="featured-products__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="featured-products__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="featured-products__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="featured-products__view-all">
            {{ section.settings.view_all_text | default: 'View All' | escape }}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M13 5L21 12L13 19V14H3V10H13V5Z"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="featured-products__grid-wrapper">
      {%- comment -%}
        The carousel class is applied in Liquid (not by JS) so the layout is
        correct on first paint and never depends on scripts loading.
      {%- endcomment -%}
      <div class="featured-products__grid{% if section.settings.layout == 'carousel' %} featured-products__grid--carousel{% endif %}"
           role="list"
           data-fp-grid>
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            <div class="featured-products__item"
                 role="listitem"
                 {{ block.shopify_attributes }}>
              {%- render 'featured-products',
                  product: block.settings.product,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_quick_add: section.settings.show_quick_add,
                  show_compare_at: section.settings.show_compare_at,
                  image_size: section.settings.image_size,
                  card_style: section.settings.card_style -%}
            </div>
          {%- else -%}
            {%- comment -%}
              Placeholder cards mirror the real card settings (style, image
              size) so every setting previews correctly before products are
              selected.
            {%- endcomment -%}
            <div class="featured-products__item featured-products__item--placeholder" role="listitem" {{ block.shopify_attributes }}>
              <div class="product-card product-card--{{ section.settings.card_style }}">
                <div class="product-card__image-wrapper product-card__image-wrapper--{{ section.settings.image_size }}">
                  <div class="product-card__image-placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  {%- if section.settings.show_compare_at -%}
                    <div class="product-card__badges">
                      <span class="product-card__badge product-card__badge--sale">
                        {{ 'products.product.on_sale' | t }}
                      </span>
                    </div>
                  {%- endif -%}
                </div>
                <div class="product-card__info">
                  {%- if section.settings.show_vendor -%}
                    <p class="product-card__vendor">Sample Vendor</p>
                  {%- endif -%}
                  <p class="product-card__title">Sample Product</p>
                  {%- if section.settings.show_rating -%}
                    <div class="product-card__rating">
                      <span class="product-card__stars" aria-hidden="true">
                        {%- for i in (1..4) -%}
                          <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                        {%- endfor -%}
                        <svg class="empty" viewBox="0 0 24 24"><path d="M22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.45 13.97L5.82 21.02L12 17.27L18.18 21.02L16.54 13.97L22 9.24ZM12 15.4V6.1L13.71 10.13L18.09 10.5L14.77 13.39L15.76 17.67L12 15.4Z"/></svg>
                      </span>
                      <span class="product-card__rating-count">(12)</span>
                    </div>
                  {%- endif -%}
                  <div class="product-card__price{% if section.settings.show_compare_at %} product-card__price--sale{% endif %}">
                    <span class="product-card__price-current">{{ 4999 | money }}</span>
                    {%- if section.settings.show_compare_at -%}
                      <span class="product-card__price-compare">{{ 6999 | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.layout == 'carousel' and section.blocks.size > 1 -%}
      <div class="featured-products__carousel-nav" data-fp-nav hidden>
        <button class="featured-products__carousel-btn featured-products__carousel-btn--prev"
                type="button"
                aria-label="{{ 'sections.featured_products.previous' | t }}"
                data-fp-prev>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15.41 7.41L14 6L8 12L14 18L15.41 16.59L10.83 12L15.41 7.41Z"/>
          </svg>
        </button>
        <button class="featured-products__carousel-btn featured-products__carousel-btn--next"
                type="button"
                aria-label="{{ 'sections.featured_products.next' | t }}"
                data-fp-next>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M10 6L8.59 7.41L13.17 12L8.59 16.59L10 18L16 12L10 6Z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.settings.view_all_link == blank -%}
      <div class="featured-products__footer">
        <a href="{{ routes.all_products_collection_url }}" class="featured-products__view-all featured-products__view-all--centered">
          {{ section.settings.view_all_text | default: 'View All Products' | escape }}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M13 5L21 12L13 19V14H3V10H13V5Z"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<script src="{{ 'featured-products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "featured-products-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ]
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Products per row",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "info": "Number of products to display per row on desktop"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between products",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false,
      "info": "Stretches the section beyond the 1280px page width. Only visible on screens wider than that."
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Best Sellers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our most popular products loved by our customers</p>"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button link",
      "info": "Leave empty to link to /collections/all"
    },
    {
      "type": "header",
      "content": "Product Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor/brand",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true,
      "info": "Shown for products that have a reviews.rating metafield"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true,
      "info": "Adds an 'Add to Cart' button on product cards. On desktop it appears when hovering a card."
    },
    {
      "type": "checkbox",
      "id": "show_compare_at",
      "label": "Show compare at price",
      "default": true,
      "info": "Shows the original price for products that have a compare-at price set in the admin"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "info": "Controls the height of the product image area"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "standard",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_shadow",
      "label": "Card shadow color",
      "default": "rgba(0, 0, 0, 0.1)"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section ARIA label",
      "default": "Featured products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Collection",
      "settings": {
        "heading": "Featured Products",
        "subheading": "Our Best Sellers",
        "products_per_row": "4",
        "layout": "grid"
      },
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
