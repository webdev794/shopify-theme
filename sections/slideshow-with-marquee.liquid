{% comment %}
  Slideshow with Marquee Section
  Version: 1.0
  Description: A full-width slideshow with a scrolling marquee text overlay
{% endcomment %}

{{ 'slideshow-with-marquee.css' | asset_url | stylesheet_tag }}

<div class="slideshow-with-marquee" 
     data-section-id="{{ section.id }}"
     data-section-type="slideshow-with-marquee"
     data-autoplay="{{ section.settings.autoplay }}"
     data-autoplay-speed="{{ section.settings.autoplay_speed }}"
     data-stop-on-hover="{{ section.settings.stop_on_hover }}"
     data-slide-height="{{ section.settings.slide_height }}">
  <div class="slideshow-with-marquee__wrapper">
    <div class="slideshow-with-marquee__slideshow">
      {%- for block in section.blocks -%}
        <div class="slideshow-with-marquee__slide" 
             data-index="{{ forloop.index0 }}"
             {% if forloop.first %}data-active="true"{% endif %}
             {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <div class="slideshow-with-marquee__image-wrapper">
              <img
                src="{{ block.settings.image | img_url: '2000x', crop: 'center' }}"
                srcset="{{ block.settings.image | img_url: '2000x', crop: 'center' }} 1x, {{ block.settings.image | img_url: '4000x', crop: 'center' }} 2x"
                alt="{{ block.settings.image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="2000"
                height="800"
                class="slideshow-with-marquee__image"
              >
            </div>
          {%- else -%}
            <div class="slideshow-with-marquee__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow-with-marquee__placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="slideshow-with-marquee__content">
            <div class="slideshow-with-marquee__content-inner page-width">
              {%- if block.settings.heading != blank -%}
                <h2 class="slideshow-with-marquee__heading">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              
              {%- if block.settings.subheading != blank -%}
                <p class="slideshow-with-marquee__subheading">
                  {{ block.settings.subheading | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="slideshow-with-marquee__button btn">
                  {{ block.settings.button_text | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="slideshow-with-marquee__empty">
          <p>Add slides to display them here.</p>
          {%- if shop.editor_mode -%}
            <p><small>Click "Add block" to add slides</small></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow-with-marquee__controls">
        <button class="slideshow-with-marquee__control slideshow-with-marquee__control--prev" type="button" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <div class="slideshow-with-marquee__dots">
          {%- for block in section.blocks -%}
            <button class="slideshow-with-marquee__dot{% if forloop.first %} slideshow-with-marquee__dot--active{% endif %}" 
                    data-index="{{ forloop.index0 }}" 
                    type="button"
                    aria-label="Slide {{ forloop.index }}">
              <span class="slideshow-with-marquee__dot-indicator"></span>
            </button>
          {%- endfor -%}
        </div>
        <button class="slideshow-with-marquee__control slideshow-with-marquee__control--next" type="button" aria-label="Next slide">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_marquee and section.settings.marquee_text != blank -%}
    <div class="slideshow-with-marquee__marquee" style="--marquee-duration: {{ section.settings.marquee_speed }}s;">
      <div class="slideshow-with-marquee__marquee-track">
        {%- assign marquee_repeats = 4 -%}
        {%- for i in (1..marquee_repeats) -%}
          <span class="slideshow-with-marquee__marquee-text">{{ section.settings.marquee_text | escape }}</span>
          <span class="slideshow-with-marquee__marquee-divider">•</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'slideshow-with-marquee.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Slideshow with Marquee",
  "tag": "section",
  "class": "slideshow-with-marquee-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Slideshow Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height",
      "min": 400,
      "max": 800,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show marquee bar",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "Free Shipping • 30-Day Returns • Subscribe & Save 10% • Shop Now"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "color",
      "id": "marquee_bg",
      "label": "Marquee background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Slide overlay color",
      "default": "rgba(0, 0, 0, 0.3)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Slide text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label",
      "default": "Slideshow with marquee"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 2000x800px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide Title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "A compelling message for your customers"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow with Marquee",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "New Collection",
            "subheading": "Discover our latest arrivals",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Limited Time Offer",
            "subheading": "Up to 50% off select items",
            "button_text": "View Deals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Subscribe & Save",
            "subheading": "Get 10% off your first order",
            "button_text": "Learn More"
          }
        }
      ]
    }
  ]
}
{% endschema %}