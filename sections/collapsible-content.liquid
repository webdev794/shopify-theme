{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="collapsible-content content-container color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding collapsible-content--{{ section.settings.layout }}">

    {%- if section.settings.layout == 'row' and section.settings.image != blank -%}
      <div class="collapsible-content__media">
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag: loading: 'lazy', widths: '400,600,800,1000', class: 'collapsible-content__image'
        }}
      </div>
    {%- endif -%}

    <div class="collapsible-content__wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="collapsible-content__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.caption != blank -%}
        <p class="collapsible-content__caption">{{ section.settings.caption }}</p>
      {%- endif -%}

      <div class="collapsible-content__rows">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'collapsible_row' -%}
              <details
                class="collapsible-row"
                {% if forloop.first and section.settings.open_first_row %}open{% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="collapsible-row__toggle">
                  <span class="collapsible-row__heading">
                    {%- if block.settings.icon != blank -%}
                      <span class="collapsible-row__icon">
                        {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                      </span>
                    {%- endif -%}
                    {{ block.settings.heading }}
                  </span>
                  <span class="collapsible-row__chevron">
                    {% render 'icon-chevron-down' %}
                  </span>
                </summary>
                <div class="collapsible-row__content rte">
                  {{ block.settings.row_content }}
                </div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.layout == 'section' and section.settings.image != blank -%}
      <div class="collapsible-content__media collapsible-content__media--below">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '600,900,1200', class: 'collapsible-content__image'
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collapsible content",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "row", "label": "Image beside rows" },
        { "value": "section", "label": "Image below rows" }
      ],
      "default": "row"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients & how to use"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (optional)"
    },
    {
      "type": "checkbox",
      "id": "open_first_row",
      "label": "Open first row by default",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ingredients"
        },
        {
          "type": "richtext",
          "id": "row_content",
          "label": "Content",
          "default": "<p>Describe this row's content.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "blocks": [
        { "type": "collapsible_row" },
        { "type": "collapsible_row" },
        { "type": "collapsible_row" }
      ]
    }
  ]
}
{% endschema %}
