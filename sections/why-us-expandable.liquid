{%- comment -%}
  Why Us (Expandable Fan Panels)
  A genuinely different take on "Why Choose Us": instead of an icon grid or
  row, each reason lives in a tall vertical panel. At rest, only an icon and
  a vertical (sideways) title are visible. Hovering/tapping/focusing a
  panel widens it (and narrows every other panel — single source of truth,
  no CSS-vs-JS state conflict) to reveal the full title + description -
  like a fan of cards opening. Each panel can use a solid color OR a
  background image with an adjustable dark overlay for text legibility. On
  mobile this becomes a simple tap-to-expand accordion (panels stack,
  height expands instead of width). Self-contained styles + behaviour.
{%- endcomment -%}

{%- liquid
  assign wu_padding_top = section.settings.padding_top
  assign wu_padding_bottom = section.settings.padding_bottom
  assign wu_padding_top_mobile = wu_padding_top | times: 0.5 | round
  assign wu_padding_bottom_mobile = wu_padding_bottom | times: 0.5 | round
  assign panel_blocks = section.blocks | where: 'type', 'panel'

  assign wu_label_color = section.settings.accent_color
  assign wu_contrast = section.settings.accent_color | color_contrast: section.settings.background_color
  if wu_contrast < 4.5
    assign wu_label_color = section.settings.accent_color | color_darken: 25
  endif
-%}

{%- capture icon_truck -%}<svg viewBox="0 0 24 24" fill="none"><path d="M2 6h11v10H2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13 10h4l4 3.5V16h-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6.5" cy="18" r="1.8" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="18" r="1.8" stroke="currentColor" stroke-width="1.6"/></svg>{%- endcapture -%}
{%- capture icon_shield -%}<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l2.7 5.9 6.3.6-4.8 4.3 1.4 6.2L12 16.9l-5.6 3.1 1.4-6.2L3 9.5l6.3-.6L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none"><path d="M12 20.5s-7.5-4.6-9.8-9.2C.7 7.7 2.4 4 6 4c2 0 3.6 1.1 4.5 2.7C11.4 5.1 13 4 15 4c3.6 0 5.3 3.7 3.8 7.3-2.3 4.6-9.8 9.2-9.8 9.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_leaf -%}<svg viewBox="0 0 24 24" fill="none"><path d="M5 19c9 1 14-4 14-14-10 0-14 5-14 14Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 19c2-5 5-8 9-10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture icon_drop -%}<svg viewBox="0 0 24 24" fill="none"><path d="M12 3s6 6.5 6 11a6 6 0 1 1-12 0c0-4.5 6-11 6-11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_gift -%}<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="9" width="18" height="12" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18v4H3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 9v12M12 9c-1.8 0-4-1-4-3.2S10 3 12 5c0-2 2.2-3.2 4-3.2S16.8 5.8 15 8c-1 .8-2 1-3 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture icon_lock -%}<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} .wu-padding {
    padding-top: var(--wu-padding-top);
    padding-bottom: var(--wu-padding-bottom);
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wu-padding {
      padding-top: var(--wu-padding-top-mobile);
      padding-bottom: var(--wu-padding-bottom-mobile);
    }
  }

  #shopify-section-{{ section.id }} .wu {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    color: var(--wu-text);
  }

  #shopify-section-{{ section.id }} .wu__intro {
    max-width: 620px;
    margin: 0 auto clamp(36px, 6vw, 60px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .wu__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wu-accent);
  }
  #shopify-section-{{ section.id }} .wu__eyebrow::before,
  #shopify-section-{{ section.id }} .wu__eyebrow::after {
    content: '';
    width: 22px;
    height: 2px;
    background: currentColor;
  }
  #shopify-section-{{ section.id }} .wu__heading {
    margin: 0 0 10px;
    font-weight: 800;
    line-height: 1.15;
    font-size: clamp(26px, 3.6vw, 44px);
  }
  #shopify-section-{{ section.id }} .wu__subheading {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    opacity: 0.72;
  }

  /* ---------- Fan panels (desktop) ---------- */
  #shopify-section-{{ section.id }} .wu__fan {
    display: flex;
    gap: 6px;
    height: clamp(360px, 42vw, 480px);
    border-radius: 20px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .wu__panel {
    all: unset;
    box-sizing: border-box;
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 74px;
    height: 100%;
    background: var(--wu-panel-bg);
    color: var(--wu-panel-text);
    cursor: pointer;
    overflow: hidden;
    /* Single source of truth: only .is-expanded (set/removed by JS on
       hover, focus, and tap) controls width — no separate CSS :hover
       rule, so panels never fight over which one should be wide. */
    transition: flex-grow 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #shopify-section-{{ section.id }} .wu__panel.is-expanded { flex-grow: 3.6; }
  #shopify-section-{{ section.id }} .wu__panel:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
  }

  /* Background media (image or solid color, set via inline custom props) */
  #shopify-section-{{ section.id }} .wu__panel-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .wu__panel-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #shopify-section-{{ section.id }} .wu__panel.is-expanded .wu__panel-media img {
    transform: scale(1.06);
  }
  #shopify-section-{{ section.id }} .wu__panel-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--wu-panel-bg);
    opacity: var(--wu-scrim-opacity, 1);
  }
  #shopify-section-{{ section.id }} .wu__panel-scrim::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 100%);
  }

  #shopify-section-{{ section.id }} .wu__panel-number {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .wu__panel-collapsed {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 24px 0 28px;
    opacity: 1;
    transition: opacity 0.35s ease;
  }
  #shopify-section-{{ section.id }} .wu__panel.is-expanded .wu__panel-collapsed {
    opacity: 0;
  }
  #shopify-section-{{ section.id }} .wu__panel-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .wu__panel-icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .wu__panel-vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .wu__panel-expanded {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 10px;
    padding: 28px;
    opacity: 0;
    translate: 0 10px;
    transition: opacity 0.4s ease 0.1s, translate 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.1s;
    text-align: left;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .wu__panel.is-expanded .wu__panel-expanded {
    opacity: 1;
    translate: 0 0;
  }
  #shopify-section-{{ section.id }} .wu__panel-icon--large { width: 34px; height: 34px; margin-bottom: 4px; }
  #shopify-section-{{ section.id }} .wu__panel-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .wu__panel-text {
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.92;
    max-width: 34ch;
  }
  #shopify-section-{{ section.id }} .wu__panel-text p { margin: 0; }

  #shopify-section-{{ section.id }} .wu__empty {
    text-align: center;
    padding: 60px 20px;
    border: 1.5px dashed rgba(0, 0, 0, 0.2);
    border-radius: 16px;
    opacity: 0.6;
  }

  /* ---------- Mobile: vertical tap-accordion instead of side-by-side fan ---------- */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wu__fan {
      flex-direction: column;
      height: auto;
      gap: 8px;
    }
    #shopify-section-{{ section.id }} .wu__panel {
      flex-grow: 0;
      min-width: 0;
      height: auto;
    }
    #shopify-section-{{ section.id }} .wu__panel-collapsed {
      position: static;
      flex-direction: row;
      justify-content: flex-start;
      padding: 18px 20px 18px 52px;
      gap: 14px;
    }
    #shopify-section-{{ section.id }} .wu__panel-vertical {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 15px;
    }
    #shopify-section-{{ section.id }} .wu__panel-expanded {
      position: static;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 1;
      translate: 0 0;
      padding: 0 20px 0 52px;
      transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #shopify-section-{{ section.id }} .wu__panel-expanded > * { overflow: hidden; }
    #shopify-section-{{ section.id }} .wu__panel.is-expanded .wu__panel-expanded {
      grid-template-rows: 1fr;
      padding-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .wu__panel .wu__panel-icon--large,
    #shopify-section-{{ section.id }} .wu__panel .wu__panel-title { display: none; }
    #shopify-section-{{ section.id }} .wu__panel.is-expanded .wu__panel-collapsed { opacity: 1; }
    #shopify-section-{{ section.id }} .wu__panel-number { top: 16px; left: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .wu__panel,
    #shopify-section-{{ section.id }} .wu__panel-collapsed,
    #shopify-section-{{ section.id }} .wu__panel-expanded,
    #shopify-section-{{ section.id }} .wu__panel-media img {
      transition: none !important;
    }
  }
</style>

<div
  class="wu-padding"
  style="
    --wu-padding-top: {{ wu_padding_top }}px;
    --wu-padding-bottom: {{ wu_padding_bottom }}px;
    --wu-padding-top-mobile: {{ wu_padding_top_mobile }}px;
    --wu-padding-bottom-mobile: {{ wu_padding_bottom_mobile }}px;
    background: {{ section.settings.background_color }};
  "
>
  <div class="wu" data-wu style="--wu-text: {{ section.settings.text_color }}; --wu-accent: {{ wu_label_color }};">
    {%- if section.settings.eyebrow_text != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="wu__intro">
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="wu__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wu__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="wu__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if panel_blocks.size > 0 -%}
      <div class="wu__fan" data-wu-fan role="list">
        {%- for block in panel_blocks -%}
          {%- liquid
            assign panel_bg = block.settings.panel_color
            assign panel_image = block.settings.panel_image
            assign panel_text = '#ffffff'
            assign scrim_opacity = 1

            if panel_image != blank
              assign panel_text = '#ffffff'
              assign scrim_opacity = block.settings.overlay_opacity | divided_by: 100.0
            else
              assign panel_contrast = '#ffffff' | color_contrast: panel_bg
              if panel_contrast < 4.5
                assign panel_text = '#1a1a1a'
              endif
            endif

            case block.settings.icon
              when 'truck'
                assign icon_svg = icon_truck
              when 'shield'
                assign icon_svg = icon_shield
              when 'star'
                assign icon_svg = icon_star
              when 'heart'
                assign icon_svg = icon_heart
              when 'leaf'
                assign icon_svg = icon_leaf
              when 'drop'
                assign icon_svg = icon_drop
              when 'clock'
                assign icon_svg = icon_clock
              when 'gift'
                assign icon_svg = icon_gift
              when 'lock'
                assign icon_svg = icon_lock
              else
                assign icon_svg = icon_star
            endcase
          -%}
          <button
            type="button"
            class="wu__panel{% if forloop.first %} is-expanded{% endif %}"
            data-wu-panel="{{ forloop.index0 }}"
            role="listitem"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
            style="--wu-panel-bg: {{ panel_bg }}; --wu-panel-text: {{ panel_text }}; --wu-scrim-opacity: {{ scrim_opacity }};"
            {{ block.shopify_attributes }}
          >
            {%- if panel_image != blank -%}
              <span class="wu__panel-media" aria-hidden="true">
                {{ panel_image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(max-width: 749px) 100vw, 20vw', loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
            <span class="wu__panel-scrim" aria-hidden="true"></span>

            <span class="wu__panel-number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

            <span class="wu__panel-collapsed" aria-hidden="true">
              <span class="wu__panel-icon">{{ icon_svg }}</span>
              <span class="wu__panel-vertical">{{ block.settings.title | escape }}</span>
            </span>

            <span class="wu__panel-expanded">
              <span class="wu__panel-icon wu__panel-icon--large">{{ icon_svg }}</span>
              <span class="wu__panel-title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="wu__panel-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </button>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="wu__empty">
        <p>Add a "Panel" block to get started.</p>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-wu]');
    var fan = root ? root.querySelector('[data-wu-fan]') : null;
    if (!fan || fan.dataset.wuInit === 'true') return;
    fan.dataset.wuInit = 'true';

    var panels = Array.prototype.slice.call(fan.querySelectorAll('[data-wu-panel]'));
    if (!panels.length) return;

    var isTouch = window.matchMedia && !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var defaultPanel = panels[0];

    function setExpanded(target) {
      panels.forEach(function (p) {
        var expanded = p === target;
        p.classList.toggle('is-expanded', expanded);
        p.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      });
    }

    function collapseAll() {
      panels.forEach(function (p) {
        p.classList.remove('is-expanded');
        p.setAttribute('aria-expanded', 'false');
      });
    }

    if (isTouch) {
      // Touch: tapping toggles. Tapping an already-open panel collapses the
      // whole fan back to equal widths (no forced default).
      panels.forEach(function (panel) {
        panel.addEventListener('click', function () {
          var alreadyOpen = panel.classList.contains('is-expanded');
          if (alreadyOpen) {
            collapseAll();
          } else {
            setExpanded(panel);
          }
        });
      });
    } else {
      // Desktop: hover/focus is the single source of truth for which panel
      // is wide — this is what keeps the previously-open panel from
      // staying wide when another one opens. Leaving the whole fan reverts
      // to the first panel as the default open state.
      panels.forEach(function (panel) {
        panel.addEventListener('pointerenter', function (e) {
          if (e.pointerType !== 'mouse') return;
          setExpanded(panel);
        });
        panel.addEventListener('focus', function () {
          setExpanded(panel);
        });
        // Clicking still "pins" a panel open (useful for touch-with-mouse
        // hybrid devices, and for keyboard Enter/Space activation).
        panel.addEventListener('click', function () {
          setExpanded(panel);
        });
      });
      fan.addEventListener('pointerleave', function (e) {
        if (e.pointerType !== 'mouse') return;
        setExpanded(defaultPanel);
      });
      fan.addEventListener('focusout', function (e) {
        // Only revert once focus has actually left the whole fan.
        if (!fan.contains(e.relatedTarget)) {
          setExpanded(defaultPanel);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Why Us (Expandable)",
  "tag": "section",
  "class": "section-why-us-fan",
  "settings": [
    { "type": "header", "content": "Header content" },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow label",
      "default": "Why Suvara"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reasons to trust your skin with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hover or tap a panel to explore"
    },
    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7F1E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow accent color",
      "default": "#C9457A"
    },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "lock", "label": "Lock" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinically tested"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Every formula is dermatologist-tested before it ever reaches your shelf.</p>"
        },
        { "type": "header", "content": "Background" },
        {
          "type": "color",
          "id": "panel_color",
          "label": "Panel background color",
          "info": "Used as the panel's solid background, or as the overlay tint on top of the image below.",
          "default": "#2A211D"
        },
        {
          "type": "image_picker",
          "id": "panel_image",
          "label": "Panel background image (optional)",
          "info": "If set, this replaces the solid color as the panel's background; the color above becomes a tinted overlay for text legibility."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 40,
          "info": "Only used when a background image is set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Us (Expandable)",
