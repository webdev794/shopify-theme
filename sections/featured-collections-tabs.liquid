{% comment %} Featured Collections Tabs {% endcomment %}

<link rel="stylesheet" href="{{ 'section-featured-collections-tabs.css' | asset_url }}" media="print" onload="this.media='all'">

<div class="featured-collections-tabs section-{{ section.id }} page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <div class="section-header text-{{ section.settings.heading_alignment }}">
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="tabs-nav" role="tablist">
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- if collection != empty -%}
        <button class="tab-button{% if forloop.first %} active{% endif %}" 
                data-tab="{{ block.id }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="tab-content-{{ block.id }}">
          {{ block.settings.tab_title | default: collection.title | escape }}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="tabs-content">
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- if collection != empty -%}
        <div id="tab-content-{{ block.id }}" class="tab-panel{% if forloop.first %} active{% endif %}" role="tabpanel" data-tab="{{ block.id }}">
          
          <div class="products-grid grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-mobile">
            {%- for product in collection.products limit: section.settings.products_to_show -%}
              {% render 'card-product', 
                card_product: product, 
                show_vendor: section.settings.show_vendor, 
                show_rating: section.settings.show_rating,
                media_aspect_ratio: section.settings.image_ratio,
                show_quick_add: false %}   <!-- optional: adjust if you use quick add -->
            {%- endfor -%}
          </div>

          {%- if section.settings.show_view_all -%}
            <div class="view-all-wrapper text-center">
              <a href="{{ collection.url }}" class="button button--secondary">
                {{ 'sections.featured_collection.view_all' | t }} {{ collection.title | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'section-featured-collections-tabs.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.featured_collections_tabs.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collections_tabs.settings.heading",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.featured_collections_tabs.settings.subheading",
      "default": "Shop our curated selections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.featured_collections_tabs.settings.heading_size",
      "options": [
        { "value": "h2", "label": "Default" },
        { "value": "h1", "label": "Large" },
        { "value": "h3", "label": "Small" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.featured_collections_tabs.settings.heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collections_tabs.settings.products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.featured_collections_tabs.settings.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:sections.featured_collections_tabs.settings.columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured_collections_tabs.settings.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.featured_collections_tabs.settings.show_rating",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.featured_collections_tabs.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collections_tabs.settings.show_view_all",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.featured_collections_tabs.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.featured_collections_tabs.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.featured_collections_tabs.blocks.collection.name",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "t:sections.featured_collections_tabs.blocks.collection.settings.tab_title",
          "info": "Optional. Defaults to collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured_collections_tabs.blocks.collection.settings.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collections_tabs.presets.name"
    }
  ]
}
{% endschema %}