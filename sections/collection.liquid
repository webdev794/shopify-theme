{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection">
  <div class="collection__header collection__page-width">
    {% if section.settings.show_collection_image and collection.image %}
      <div class="collection__banner">
        {{
          collection.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,900,1200,1600',
            sizes: '100vw',
            alt: collection.image.alt | default: collection.title,
            class: 'collection__banner-image'
        }}
      </div>
    {% endif %}

    <h1 class="collection__title">{{ collection.title }}</h1>

    {% if collection.description != blank %}
      <div class="collection__description rte">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection__toolbar collection__page-width">
      <p class="collection__count">
        {{ 'collections.general.items_with_count' | t: count: paginate.items }}
      </p>

      {% if section.settings.enable_sorting and collection.sort_options.size > 1 %}
        <form class="collection__sort" method="get">
          <label for="sort-by-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label>
          <select
            name="sort_by"
            id="sort-by-{{ section.id }}"
            class="collection__sort-select"
            onchange="this.form.submit()"
          >
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </form>
      {% endif %}
    </div>

    {% if paginate.items == 0 %}
      <div class="collection__empty collection__page-width">
        <p>{{ 'collections.general.no_matches' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{ 'collections.general.view_all' | t }}
        </a>
      </div>
    {% else %}
      <div
        class="collection__grid collection__page-width"
        style="
          --columns-desktop: {{ section.settings.columns_desktop }};
          --columns-mobile: {{ section.settings.columns_mobile }};
        "
        data-image-ratio="{{ section.settings.image_ratio }}"
      >
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-card__media">
              <a
                href="{{ product.url }}"
                class="product-card__media-link"
                aria-label="{{ product.title | escape }}"
              >
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,400,500,600,800',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: product.featured_image.alt | default: product.title,
                      class: 'product-card__image product-card__image--primary'
                  }}
                  {% if product.images.size > 1 %}
                    {{
                      product.images[1]
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,400,500,600,800',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        alt: '',
                        class: 'product-card__image product-card__image--secondary'
                    }}
                  {% endif %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
                {% endif %}
              </a>

              <div class="product-card__badges">
                {% unless product.available %}
                  <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
                {% else %}
                  {% if section.settings.show_sale_badge and product.compare_at_price_min > product.price_min %}
                    <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
                  {% endif %}
                {% endunless %}
              </div>

              {% if section.settings.show_quick_add and product.available %}
                <div class="product-card__quick-add">
                  {% if product.has_only_default_variant %}
                    {% form 'product', product %}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="button button--secondary product-card__quick-add-button">
                        {{ 'products.product.add_to_cart' | t }}
                      </button>
                    {% endform %}
                  {% else %}
                    <a href="{{ product.url }}" class="button button--secondary product-card__quick-add-button">
                      {{ 'products.product.choose_options' | t }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="product-card__content">
              {% if section.settings.show_vendor and product.vendor != blank %}
                <p class="product-card__vendor">{{ product.vendor }}</p>
              {% endif %}

              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="product-card__price">
                {% if product.price_varies %}
                  <span class="product-card__price-from">{{ 'products.product.from_price_html' | t }}</span>
                {% endif %}

                {% if product.compare_at_price_min > product.price_min %}
                  <span class="price price--sale">{{ product.price_min | money }}</span>
                  <span class="price price--compare">
                    <s>{{ product.compare_at_price_min | money }}</s>
                  </span>
                {% else %}
                  <span class="price">{{ product.price_min | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="collection__pagination collection__page-width">
      {{ paginate | default_pagination }}
    </div>
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection {
    padding-block: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .collection__page-width {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* ---------- Header ---------- */
  .collection__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .collection__banner {
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .collection__banner-image {
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  .collection__title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
  }

  .collection__description {
    color: var(--color-foreground-secondary, #555);
    max-width: 60ch;
    line-height: 1.6;
  }

  /* ---------- Toolbar ---------- */
  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-block: 1px solid var(--color-border, #e5e5e5);
    padding-block: 0.75rem;
  }

  .collection__count {
    font-size: 0.9rem;
    color: var(--color-foreground-secondary, #666);
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .collection__sort-select {
    padding: 0.4rem 0.6rem;
    border-radius: 0.35rem;
    border: 1px solid var(--color-border, #ccc);
    background: var(--color-background, #fff);
  }

  /* ---------- Empty state ---------- */
  .collection__empty {
    text-align: center;
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--color-foreground-secondary, #666);
  }

  /* ---------- Grid ---------- */
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
    gap: 1rem 0.75rem;
  }

  @media screen and (min-width: 750px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
      gap: 1.5rem;
    }
  }

  /* ---------- Product card ---------- */
  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-background-secondary, #f4f4f4);
  }

  .collection__grid[data-image-ratio='portrait'] .product-card__media {
    aspect-ratio: 3 / 4;
  }

  .collection__grid[data-image-ratio='natural'] .product-card__media {
    aspect-ratio: auto;
  }

  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .product-card__media:hover .product-card__image--secondary,
  .product-card__media:focus-within .product-card__image--secondary {
    opacity: 1;
  }

  .product-card__badges {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    pointer-events: none;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .badge--sale {
    background: var(--color-sale, #c0392b);
    color: #fff;
  }

  .badge--sold-out {
    background: var(--color-foreground-secondary, #999);
    color: #fff;
  }

  .product-card__quick-add {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .product-card__media:hover .product-card__quick-add,
  .product-card__media:focus-within .product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add-button {
    width: 100%;
    text-align: center;
    padding: 0.6rem 1rem;
    border-radius: 0.35rem;
    border: none;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    display: block;
  }

  .product-card__content {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .product-card__vendor {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground-secondary, #888);
  }

  .product-card__title {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    text-decoration: underline;
  }

  .product-card__price {
    font-size: 0.95rem;
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .product-card__price-from {
    font-size: 0.75rem;
    color: var(--color-foreground-secondary, #888);
  }

  .price--sale {
    color: var(--color-sale, #c0392b);
    font-weight: 600;
  }

  .price--compare {
    color: var(--color-foreground-secondary, #999);
  }

  /* ---------- Pagination ---------- */
  .collection__pagination {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .collection__pagination nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .collection__pagination nav a,
  .collection__pagination nav span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-foreground, #1a1a1a);
  }

  .collection__pagination nav a:hover {
    background: var(--color-background-secondary, #f4f4f4);
  }

  .collection__pagination nav [aria-current='page'] {
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "header",
      "content": "Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sort by",
      "default": true
    }
  ]
}
{% endschema %}
