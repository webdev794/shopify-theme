{% comment %}
  Mobile slide-out menu
{% endcomment %}

<div class="inner-side-outer" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile menu">
  <ul class="list-unstyled mobile-tabs-wrapper" role="tablist">
    <li class="menu-tab active" data-tab="side-menu-wrapper" role="tab" aria-selected="true" aria-controls="side-menu-wrapper" tabindex="0">Menu</li>
    <li class="menu-tab" data-tab="mobile-category-menu-bar" role="tab" aria-selected="false" aria-controls="mobile-category-menu-bar" tabindex="0">SHOP ALL CATEGORIES</li>
  </ul>

  <div class="inner-side">
    
        <!-- ==================== MAIN MENU TAB ==================== -->
    <div class="side-menu-wrapper tabcontent active" id="side-menu-wrapper" role="tabpanel" aria-label="Main menu">
      <ul class="list-unstyled">
        {% for link in linklists[section.settings.menu].links %}   <!-- Changed from category_menu to menu -->
          <li class="nav-item">
            <div class="nav-item-header small-font">
              <a href="{{ link.url }}" title="{{ link.title }}" tabindex="-1">{{ link.title }}</a>
              {% if link.links.size > 0 %}
                <span data-submenu-trigger="main{{ forloop.index }}" role="button" aria-expanded="false" tabindex="0">
                  {% render 'icon-chevron-down' %}
                </span>
              {% endif %}
            </div>
           
            {% if link.links.size > 0 %}
              <div class="inner-child" data-inner-item="main{{ forloop.index }}" role="list">
                <ul class="list-unstyled">
                  {% for child in link.links %}
                    <li>
                      <a href="{{ child.url }}" title="{{ child.title }}">{{ child.title }}</a>
                      {% if child.links.size > 0 %}
                        <ul class="list-unstyled">
                          {% for grandchild in child.links %}
                            <li>
                              <a href="{{ grandchild.url }}" title="{{ grandchild.title }}">{{ grandchild.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      <div class="menu-btn small-font">
        <a class="button" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {% if customer %}My Account{% else %}Log in{% endif %}
        </a>
      </div>
    </div>

    <!-- ==================== CATEGORIES TAB ==================== -->
    <div class="mobile-category-menu-bar tabcontent hidden" id="mobile-category-menu-bar" role="tabpanel" aria-label="Categories menu">
      <ul class="list-unstyled">
        {% for link in linklists[section.settings.category_menu].links %}   <!-- Changed from menu to category_menu -->
          <li class="nav-item">
            <div class="nav-item-header small-font">
              <a href="{{ link.url }}" title="{{ link.title }}" role="menuitem" tabindex="-1">{{ link.title }}</a>
              {% if link.links.size > 0 %}
                <span data-submenu-trigger="cat{{ forloop.index }}" role="button" aria-expanded="false" tabindex="0">
                  {% render 'icon-chevron-down' %}
                </span>
              {% endif %}
            </div>
           
            {% if link.links.size > 0 %}
              <div class="inner-child" data-inner-item="cat{{ forloop.index }}" role="list">
                <ul class="list-unstyled">
                  {% for child in link.links %}
                    <li>
                      <a href="{{ child.url }}" title="{{ child.title }}">{{ child.title }}</a>
                      {% if child.links.size > 0 %}
                        <ul class="list-unstyled">
                          {% for grandchild in child.links %}
                            <li>
                              <a href="{{ grandchild.url }}" title="{{ grandchild.title }}">{{ grandchild.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Mobile Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %} 