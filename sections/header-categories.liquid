{% comment %}
  Categories mega menu for desktop
{% endcomment %}

<div class="secondary-header d-none d-lg-block">
  <div class="container">
    <div class="header-nav-blocks">
      <details-disclosure class="header-categories">
        <details class="header-categories-inner category-custom-details-disclosure">
          <summary class="categories-menu small-font">
            <svg class="bars-icon" width="18" height="12" viewBox="0 0 18 12" fill="none">
              <path d="M0 0H18V2H0V0Z" fill="currentColor"></path>
              <path d="M0 5H18V7H0V5Z" fill="currentColor"></path>
              <path d="M0 10H18V12H0V10Z" fill="currentColor"></path>
            </svg>
            <span><strong>SHOP ALL CATEGORIES</strong></span>
            {% render 'icon-angle-down' %}
          </summary>
          <div class="header-categories-wrapper style_1">
            <ul class="categories-submenu">
              {% for link in linklists[section.settings.category_menu].links %}
                <li class="categories-submenu-item sub-category-menu" data-index="{{ forloop.index }}">
                  <a href="{{ link.url }}" class="categories-submenu-link" title="{{ link.title }}">
                    <span class="categories-submenu-link-text">{{ link.title }}</span>
                    {% if link.links.size > 0 %}
                      <svg width="5" height="8" viewBox="0 0 5 8" fill="none" class="angle-right">
                        <path d="M1 7L4 4L1 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    {% endif %}
                  </a>
                  
                  {% if link.links.size > 0 %}
                    <div class="categories-inner--submenu sub-category-menu-content-{{ forloop.index }}" data-index="{{ forloop.index }}">
                      <div class="categories-inner-submenu-left">
                        <ul class="categories-inner-submenu-items">
                          {% for child_link in link.links %}
                            <li>
                              <a href="{{ child_link.url }}" class="categories-inner-submenu-heading" title="{{ child_link.title }}">{{ child_link.title }}</a>
                              {% if child_link.links.size > 0 %}
                                <ul>
                                  {% for grandchild_link in child_link.links %}
                                    <li class="categories-inner-submenu-item">
                                      <a href="{{ grandchild_link.url }}" title="{{ grandchild_link.title }}">{{ grandchild_link.title }}</a>
                                    </li>
                                  {% endfor %}
                                </ul>
                              {% endif %}
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </details>
      </details-disclosure>

      <!-- Main Navigation Menu + Quick Links -->
      <div class="nav-menu-wrapper quick-links-enable">
        <!-- Main Navigation - Center -->
        <ul class="nav-menu-list list-inline">
          {% for link in linklists[section.settings.main_menu].links %}
            <li class="nav-menu-item small-font {% if link.links.size > 0 %}has-children{% endif %}" data-navigation-item>
              {% if link.links.size > 0 %}
                <details class="custom-details-disclosure">
                  <summary class="nav-menu-link">
                    <a href="{{ link.url }}" title="{{ link.title }}">
                      <strong>{{ link.title }}</strong>
                    </a>
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path d="M0 3H8V5H0V3Z" fill="currentColor"></path>
                      <path d="M5 8.74279e-08L5 8H3L3 0L5 8.74279e-08Z" fill="currentColor"></path>
                    </svg>
                  </summary>
                  <ul class="nav-submenu body-font regular-font">
                    {% for child_link in link.links %}
                      <li>
                        <details class="nav-submenu-item has-children horizontal sub-menu-custom-details-disclosure">
                          <summary class="nav-submenu-link">
                            <a class="nav-submenu-link-inner" href="{{ child_link.url }}" title="{{ child_link.title }}">{{ child_link.title }}</a>
                            {% if child_link.links.size > 0 %}
                              <span class="submenu-link-arrow">
                                <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
                                  <path d="M1 9L5 5L1 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                              </span>
                            {% endif %}
                          </summary>
                          {% if child_link.links.size > 0 %}
                            <ul class="nav-submenu inner regular-font">
                              {% for grandchild_link in child_link.links %}
                                <li class="nav-submenu-item">
                                  <a class="nav-submenu-link" href="{{ grandchild_link.url }}" title="{{ grandchild_link.title }}">{{ grandchild_link.title }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </details>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <div class="custom-details-disclosure">
                  <a href="{{ link.url }}" class="nav-menu-link" title="{{ link.title }}">
                    <strong>{{ link.title }}</strong>
                  </a>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>

        <!-- Quick Links - Right Side -->
        <!-- Quick Links - Right Side -->
        <ul class="list-inline nav-quick-links-list">
          <li class="nav-menu-item nav-quick-links-item small-font">
            <a class="nav-menu-link nav-quick-links-link" href="/pages/faqs">
              <span class="nav-quick-links-icon">
                <svg viewBox="0 0 43 43" fill="currentcolor">
                  <g><path d="m33.5,31v-3c3.58,0,6.5-2.92,6.5-6.5s-2.92-6.5-6.5-6.5v-3c5.24,0,9.5,4.26,9.5,9.5s-4.26,9.5-9.5,9.5Z"></path><path d="m9.5,31c-5.24,0-9.5-4.26-9.5-9.5s4.26-9.5,9.5-9.5v3c-3.58,0-6.5,2.92-6.5,6.5s2.92,6.5,6.5,6.5v3Z"></path><path d="m21.5,43c-.83,0-1.5-.67-1.5-1.5s.67-1.5,1.5-1.5c5.79,0,10.5-4.71,10.5-10.5V13.5c0-5.79-4.71-10.5-10.5-10.5s-10.5,4.71-10.5,10.5v16c0,.83-.67,1.5-1.5,1.5s-1.5-.67-1.5-1.5V13.5C8,6.06,14.06,0,21.5,0s13.5,6.06,13.5,13.5v16c0,7.44-6.06,13.5-13.5,13.5Z"></path></g>
                </svg>
              </span>
              <strong class="nav-quick-links-text">FAQ's</strong>
            </a>
          </li>
          <li class="nav-menu-item nav-quick-links-item small-font">
            <a class="nav-menu-link nav-quick-links-link" href="/policies/privacy-policy">
              <span class="nav-quick-links-icon">
