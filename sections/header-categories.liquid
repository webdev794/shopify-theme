          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Categories Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main navigation menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "quick_links",
      "label": "Quick Links Menu",
      "info": "Select the menu containing FAQ, Policy, Contact links"
    }
  ]
}
{% endschema %}