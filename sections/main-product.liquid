{% comment %}
  Renders the main product section: media gallery, product information,
  and add-to-cart form. Content is block-based so merchants can reorder,
  hide, or configure each piece from the theme editor.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
%}

<section
  class="product product--media-{{ section.settings.media_position }}"
  id="product-{{ section.id }}"
>
  <div class="product__container page-width">

    {% comment %} ---------- MEDIA GALLERY ---------- {% endcomment %}
    <div class="product__media">
      {% if product.media.size > 0 %}
        <div class="product__media-main" id="product-media-main-{{ section.id }}">
          {% for media in product.media %}
            {% liquid
              if forloop.first
                assign media_loading = 'eager'
                assign media_fetchpriority = 'high'
              else
                assign media_loading = 'lazy'
                assign media_fetchpriority = 'auto'
              endif
            %}
            <div
              class="product__media-item{% if media == featured_media %} is-active{% endif %}"
              id="media-{{ section.id }}-{{ media.id }}"
              data-media-id="{{ media.id }}"
            >
              {% case media.media_type %}
                {% when 'image' %}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: media_loading,
                      fetchpriority: media_fetchpriority,
                      widths: '400,600,800,1000,1200,1600',
                      sizes: '(min-width: 750px) 50vw, 100vw',
                      alt: media.alt | default: product.title,
                      class: 'product__media-image'
                  }}
                {% when 'video', 'external_video' %}
                  {{ media | media_tag: image_size: '1600x', controls: true }}
                {% when 'model' %}
                  {{ media | media_tag: image_size: '1600x' }}
                {% else %}
                  {{ media | media_tag }}
              {% endcase %}
            </div>
          {% endfor %}
        </div>

        {% if product.media.size > 1 %}
          <div class="product__media-thumbs" role="tablist" aria-label="{{ product.title }} media">
            {% for media in product.media %}
              <a
                href="#media-{{ section.id }}-{{ media.id }}"
                class="product__media-thumb{% if media == featured_media %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                role="tab"
                aria-selected="{% if media == featured_media %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 200
                  | image_tag: alt: '', loading: 'lazy', widths: '100,150,200'
                }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="product__media-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    {% comment %} ---------- PRODUCT INFO ---------- {% endcomment %}
    <div class="product__info">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'vendor' %}
            {% if product.vendor != blank %}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {% endif %}

          {% when 'title' %}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {% when 'price' %}
            <div
              class="product__price"
              id="product-price-{{ section.id }}"
              data-unit-price="{{ current_variant.price }}"
              data-money-format="{{ shop.money_format | escape }}"
              {{ block.shopify_attributes }}
            >
              {% if current_variant.compare_at_price > current_variant.price %}
                <span class="price price--sale">
                  <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                  {{ current_variant.price | money }}
                </span>
                <span class="price price--compare">
                  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                  <s>{{ current_variant.compare_at_price | money }}</s>
                </span>
              {% else %}
                <span class="price">{{ current_variant.price | money }}</span>
              {% endif %}
            </div>

          {% when 'description' %}
            {% if product.description != blank %}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {% endif %}

          {% when 'variant_picker' %}
            {% if product.has_only_default_variant == false %}
              <variant-selects
                class="product__variants"
                data-section-id="{{ section.id }}"
                {{ block.shopify_attributes }}
              >
                {% for option in product.options_with_values %}
                  <fieldset class="product__option">
                    <legend class="product__option-name">
                      {{ option.name }}:
                      <span data-selected-value>{{ option.selected_value }}</span>
                    </legend>
                    <div class="product__option-values">
                      {% for value in option.values %}
                        <input
                          type="radio"
                          id="option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="option-{{ section.id }}-{{ option.position }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          class="visually-hidden product__option-input"
                        >
                        <label
                          for="option-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          class="product__option-label"
                        >
                          {{ value }}
                        </label>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}

                {% comment %}
                  Server-rendered variant data (including pre-formatted money
                  strings) so the JS never has to reimplement money formatting.
                {% endcomment %}
                <script type="application/json" data-product-variants>
                  [
                    {% for variant in product.variants %}
                      {
                        "id": {{ variant.id | json }},
                        "available": {{ variant.available | json }},
                        "options": {{ variant.options | json }},
                        "price": {{ variant.price | json }},
                        "compare_at_price": {{ variant.compare_at_price | json }},
                        "price_formatted": {{ variant.price | money | json }},
                        "compare_at_price_formatted": {{ variant.compare_at_price | money | json }},
                        "featured_media_id": {{ variant.featured_media.id | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                </script>
              </variant-selects>
            {% endif %}

          {% when 'quantity_selector' %}
            <div class="product__quantity" data-section-id="{{ section.id }}" {{ block.shopify_attributes }}>
              <label for="quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
              <div class="quantity-input">
                <button
                  type="button"
                  class="quantity-input__button"
                  data-quantity-decrease
                  aria-label="{{ 'products.product.quantity.decrease' | t }}"
                >&minus;</button>
                <input
                  type="number"
                  id="quantity-{{ section.id }}"
                  name="quantity"
                  form="product-form-{{ section.id }}"
                  value="1"
                  min="1"
                  {% if current_variant.quantity_rule.max != null %}
                    max="{{ current_variant.quantity_rule.max }}"
                  {% endif %}
                  step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                >
                <button
                  type="button"
                  class="quantity-input__button"
                  data-quantity-increase
                  aria-label="{{ 'products.product.quantity.increase' | t }}"
                >+</button>
              </div>
              <p class="product__price-total" data-price-total hidden>
                {{ 'products.product.price.total' | t }}
                <span data-price-total-amount></span>
              </p>
            </div>

          {% when 'buy_buttons' %}
            <div class="product__buy-buttons" {{ block.shopify_attributes }}>
              {% assign product_form_id = 'product-form-' | append: section.id %}
              {% form 'product', product, id: product_form_id, class: 'product__form' %}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

                <button
                  type="submit"
                  name="add"
                  class="button button--primary product__add-to-cart"
                  data-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-to-cart-text>
                    {% if current_variant.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                  </span>
                </button>

                {% if block.settings.show_dynamic_checkout %}
                  {{ form | payment_button }}
                {% endif %}
              {% endform %}
            </div>

          {% when 'custom_liquid' %}
            <div class="product__custom-liquid" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product {
    --product-gap: 2rem;
    --product-radius: 0.5rem;
    padding-block: 2rem;
  }

  .product__container {
    display: grid;
    gap: var(--product-gap);
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media screen and (min-width: 750px) {
    .product__container {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .product--media-right .product__media {
      order: 2;
    }

    .product__info {
      position: sticky;
      top: 2rem;
    }
  }

  /* ---------- Media gallery ---------- */
  .product__media-main {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border-radius: var(--product-radius);
    scrollbar-width: none;
  }

  .product__media-main::-webkit-scrollbar {
    display: none;
  }

  .product__media-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
    background: var(--color-background-secondary, #f4f4f4);
  }

  .product__media-image,
  .product__media-item img,
  .product__media-item video,
  .product__media-item model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product__media-thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    overflow-x: auto;
  }

  .product__media-thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border-radius: calc(var(--product-radius) / 2);
    overflow: hidden;
    border: 2px solid transparent;
    opacity: 0.7;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .product__media-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product__media-thumb.is-active,
  .product__media-thumb:hover {
    opacity: 1;
    border-color: var(--color-foreground, #1a1a1a);
  }

  .product__media-placeholder svg {
    width: 100%;
    height: auto;
  }

  /* ---------- Info column ---------- */
  .product__info > * + * {
    margin-top: 1rem;
  }

  .product__vendor {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--color-foreground-secondary, #666);
  }

  .product__title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    line-height: 1.15;
  }

  .product__price {
    font-size: 1.25rem;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .price--sale {
    color: var(--color-sale, #c0392b);
    font-weight: 600;
  }

  .price--compare {
    color: var(--color-foreground-secondary, #999);
    font-weight: 400;
  }

  .product__description {
    color: var(--color-foreground-secondary, #444);
    line-height: 1.6;
  }

  /* ---------- Variant picker ---------- */
  .product__variants,
  variant-selects {
    display: block;
  }

  .product__option + .product__option {
    margin-top: 1rem;
  }

  .product__option-name {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .product__option-label {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .product__option-input:checked + .product__option-label {
    border-color: var(--color-foreground, #1a1a1a);
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
  }

  .product__option-input:focus-visible + .product__option-label {
    outline: 2px solid var(--color-focus, #4a90e2);
    outline-offset: 2px;
  }

  /* ---------- Quantity ---------- */
  .quantity-input {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border, #ccc);
    border-radius: var(--product-radius);
    overflow: hidden;
  }

  .quantity-input__button {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .quantity-input__button:hover {
    background: var(--color-background-secondary, #f4f4f4);
  }

  .quantity-input input[type='number'] {
    width: 3rem;
    height: 2.5rem;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border, #ccc);
    border-right: 1px solid var(--color-border, #ccc);
    -moz-appearance: textfield;
  }

  .quantity-input input[type='number']::-webkit-outer-spin-button,
  .quantity-input input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product__price-total {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-foreground-secondary, #555);
  }

  .product__price-total[hidden] {
    display: none;
  }

  /* ---------- Buy buttons ---------- */
  .product__buy-buttons {
    max-width: 28rem;
  }

  .product__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Shopify injects its own wrapper around the dynamic checkout button;
     this margin ensures spacing even if that wrapper collapses the gap. */
  .product__form .shopify-payment-button {
    margin-top: 0.75rem;
  }

  .product__add-to-cart {
    width: 100%;
    padding: 0.9rem 1.5rem;
    border-radius: var(--product-radius);
    border: none;
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .product__add-to-cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% javascript %}
  class VariantSelects extends HTMLElement {
    constructor() {
      super();
      this.addEventListener('change', this.onVariantChange.bind(this));
    }

    connectedCallback() {
      this.sectionId = this.dataset.sectionId;
      this.variants = JSON.parse(this.querySelector('[data-product-variants]').textContent);
    }

    onVariantChange() {
      const selectedOptions = Array.from(this.querySelectorAll('.product__option')).map((fieldset) => {
        const checked = fieldset.querySelector('input:checked');
        return checked ? checked.value : null;
      });

      const variant = this.variants.find((variant) =>
        variant.options.every((option, index) => option === selectedOptions[index])
      );

      this.updateOptionLabels(selectedOptions);
      this.updateURL(variant);
      this.updateVariantInput(variant);
      this.updatePrice(variant);
      this.updateMedia(variant);
      this.updateAddToCart(variant);
    }

    updateOptionLabels(selectedOptions) {
      this.querySelectorAll('.product__option').forEach((fieldset, index) => {
        const label = fieldset.querySelector('[data-selected-value]');
        if (label) label.textContent = selectedOptions[index];
      });
    }

    updateURL(variant) {
      if (!variant || !window.history) return;
      window.history.replaceState({}, '', `${window.location.pathname}?variant=${variant.id}`);
    }

    updateVariantInput(variant) {
      if (!variant) return;
      document
        .querySelectorAll(`#product-form-${this.sectionId} [data-variant-id-input]`)
        .forEach((input) => {
          input.value = variant.id;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    updatePrice(variant) {
      if (!variant) return;
      const wrapper = document.getElementById(`product-price-${this.sectionId}`);
      if (!wrapper) return;

      if (variant.compare_at_price > variant.price) {
        wrapper.innerHTML = `
          <span class="price price--sale">${variant.price_formatted}</span>
          <span class="price price--compare"><s>${variant.compare_at_price_formatted}</s></span>
        `;
      } else {
        wrapper.innerHTML = `<span class="price">${variant.price_formatted}</span>`;
      }

      // Keep the raw cents value in sync so the quantity total can use it.
      wrapper.dataset.unitPrice = variant.price;
      updateTotalPriceForSection(this.sectionId);
    }

    updateMedia(variant) {
      if (!variant || !variant.featured_media_id) return;
      const target = document.getElementById(`media-${this.sectionId}-${variant.featured_media_id}`);
      if (!target) return;

      target.scrollIntoView({ block: 'nearest', inline: 'start', behavior: 'smooth' });

      document
        .querySelectorAll(`#product-media-main-${this.sectionId} .product__media-item`)
        .forEach((item) => item.classList.toggle('is-active', item === target));

      document
        .querySelectorAll('.product__media-thumb')
        .forEach((thumb) =>
          thumb.classList.toggle('is-active', thumb.dataset.mediaId === String(variant.featured_media_id))
        );
    }

    updateAddToCart(variant) {
      const button = document.querySelector(`#product-form-${this.sectionId} [data-add-to-cart]`);
      const text = document.querySelector(`#product-form-${this.sectionId} [data-add-to-cart-text]`);
      if (!button || !text) return;

      if (!variant) {
        button.disabled = true;
        text.textContent = window.themeStrings?.unavailable || 'Unavailable';
      } else if (!variant.available) {
        button.disabled = true;
        text.textContent = window.themeStrings?.soldOut || 'Sold out';
      } else {
        button.disabled = false;
        text.textContent = window.themeStrings?.addToCart || 'Add to cart';
      }
    }
  }

  customElements.define('variant-selects', VariantSelects);

  document.addEventListener('click', (event) => {
    const decreaseButton = event.target.closest('[data-quantity-decrease]');
    const increaseButton = event.target.closest('[data-quantity-increase]');
    if (!decreaseButton && !increaseButton) return;

    const wrapper = event.target.closest('.quantity-input');
    const input = wrapper.querySelector('input[type="number"]');
    const step = parseInt(input.step, 10) || 1;
    const min = parseInt(input.min, 10) || 1;
    let value = parseInt(input.value, 10) || min;

    value = increaseButton ? value + step : Math.max(min, value - step);
    input.value = value;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  });

  // ---------- Quantity x price total ----------
  function formatMoney(cents, format) {
    function withDelimiters(number, precision, thousands, decimalSep) {
      if (isNaN(number) || number === null) return 0;
      const fixed = (number / 100).toFixed(precision);
      const parts = fixed.split('.');
      const wholePart = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, `$1${thousands}`);
      const decimalPart = parts[1] ? decimalSep + parts[1] : '';
      return wholePart + decimalPart;
    }

    if (!format) return `$${(cents / 100).toFixed(2)}`;
    const placeholder = /\{\{\s*(\w+)\s*\}\}/;
    const match = format.match(placeholder);
    if (!match) return format;

    let value;
    switch (match[1]) {
      case 'amount_no_decimals':
        value = withDelimiters(cents, 0, ',', '.');
        break;
      case 'amount_with_comma_separator':
        value = withDelimiters(cents, 2, '.', ',');
        break;
      case 'amount_no_decimals_with_comma_separator':
        value = withDelimiters(cents, 0, '.', ',');
        break;
      case 'amount_with_apostrophe_separator':
        value = withDelimiters(cents, 2, "'", '.');
        break;
      default:
        value = withDelimiters(cents, 2, ',', '.');
    }

    return format.replace(placeholder, value);
  }

  function updateTotalPriceForSection(sectionId) {
    const quantityWrapper = document.querySelector(
      `.product__quantity[data-section-id="${sectionId}"]`
    );
    if (!quantityWrapper) return;

    const input = quantityWrapper.querySelector('input[type="number"]');
    const priceWrapper = document.getElementById(`product-price-${sectionId}`);
    const totalEl = quantityWrapper.querySelector('[data-price-total]');
    const amountEl = quantityWrapper.querySelector('[data-price-total-amount]');
    if (!input || !priceWrapper || !totalEl || !amountEl) return;

    const unitPrice = parseInt(priceWrapper.dataset.unitPrice, 10);
    const quantity = parseInt(input.value, 10) || 1;

    if (!unitPrice || quantity <= 1) {
      totalEl.hidden = true;
      return;
    }

    totalEl.hidden = false;
    amountEl.textContent = formatMoney(unitPrice * quantity, priceWrapper.dataset.moneyFormat);
  }

  document.addEventListener('input', (event) => {
    const input = event.target.closest('.product__quantity input[type="number"]');
    if (!input) return;

    const sectionId = input.closest('.product__quantity').dataset.sectionId;
    updateTotalPriceForSection(sectionId);
  });

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.product__quantity').forEach((wrapper) => {
      updateTotalPriceForSection(wrapper.dataset.sectionId);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.product",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity_selector" },
        { "type": "buy_buttons" },
        { "type": "description" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
