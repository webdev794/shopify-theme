<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font loading:
      1. Preconnect to font CDN for faster connection
      2. Fonts load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <!-- theme-check-disable RemoteAsset -->
      <link rel="preconnect" href="//fonts.shopifycdn.com" crossorigin>
      <!-- /theme-check-disable RemoteAsset -->
    {% endunless %}

    {% # Load critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'section-reveal.css' | asset_url | stylesheet_tag }}
    {{ 'product-image-reveal.css' | asset_url | stylesheet_tag }}

    {{ 'buttons.css' | asset_url | stylesheet_tag }}
    {{ 'unit-price.css' | asset_url | stylesheet_tag }}



    {% # Social, title, etc. %}

    {{ content_for_header }}

    <!-- Custom Cursor -->
    <!-- Custom Cursor -->
    <style>
      {% render 'custom-cursor' %}
    </style>
    <script src="{{ 'custom-cursor.js' | asset_url }}" defer></script>

    <!-- Shop Pay Installments -->
    <!-- theme-check-disable RemoteAsset -->
    <script src="//cdn.shopify.com/shopifycloud/shop-js/shop-installments.js" defer></script>
    <!-- /theme-check-disable RemoteAsset -->
    
    <!-- ===== Global layout safety net ===== -->
    <style>
      /* Force full height on body */
      html, body {
        min-height: 100vh !important;
        min-height: 100dvh !important;
      }

      .shopify-section-group-footer-group {
        position: relative !important;
      }

      /* Header always above page sections (mega menu background + clicks) */
      .shopify-section-group-header-group,
      .shopify-section:has(> .header) {
        position: relative !important;
        z-index: 200 !important;
        isolation: isolate;
      }

      /* Hide dev-only elements */
      #PBarNextFrameWrapper {
        display: none !important;
      }
    </style>

  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% render 'quick-view-modal' %}

    <script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
    <script src="{{ 'product-image-reveal.js' | asset_url }}" defer></script>

  </body>
</html>

