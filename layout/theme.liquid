<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ 'buttons.css' | asset_url | stylesheet_tag }}
    {{ 'unit-price.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <!-- ===== Global layout safety net ===== -->
    <style>
      /* Force full height on body */
      html, body {
        min-height: 100vh !important;
        min-height: 100dvh !important;
      }

      .shopify-section-group-footer-group {
        position: relative !important;
      }

      /* TODO: confirm this is still needed and what it targets before shipping.
         Hiding an unknown element with !important sitewide is risky if it's
         a legitimate app/preview element rather than dev-only noise. */
      #PBarNextFrameWrapper {
        display: none !important;
      }
    </style>
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
